{
    "manifest_version": 3,
    "name": "EQ12 Betting Dashboard Companion",
    "version": "0.1.0",
    "description": "Calls your EQ12 backend to get parlays, EV, and audit summaries. Optional on-page EV highlighting.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "EQ12",
        "default_popup": "src/popup.html"
    },
    "options_ui": {
        "page": "src/options.html",
        "open_in_tab": true
    },
    "background": {
        "service_worker": "src/background.js",
        "type": "module"
    },
    "permissions": [
        "storage",
        "notifications",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.ngrok.io/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.draftkings.com/*",
                "*://*.fanduel.com/*",
                "*://*.betmgm.com/*",
                "*://*.caesars.com/*",
                "*://*.barstoolsportsbook.com/*"
            ],
            "js": [
                "src/content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
