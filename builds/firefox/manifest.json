{
  "manifest_version": 2,
  "name": "EQ12 Cross-Browser Extension",
  "version": "1.0.0",
  "description": "Example cross-browser compatible extension for EQ12 governance automation",
  "permissions": [
    "activeTab",
    "storage",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "debug-utils.js",
      "polyfill.js",
      "background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "EQ12 Extension",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "debug-utils.js",
        "polyfill.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    "icons/*",
    "debug-utils.js"
  ],
  "applications": {
    "gecko": {
      "strict_min_version": "91.0"
    }
  }
}