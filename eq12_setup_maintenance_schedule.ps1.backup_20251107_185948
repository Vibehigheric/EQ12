# Create task files
$DailyTaskXML | Out-File -FilePath "C:\EQ12\eq12_daily_maintenance.xml" -Encoding UTF8
$HealthTaskXML | Out-File -FilePath "C:\EQ12\eq12_health_monitor.xml" -Encoding UTF8  
$SelfHealingTaskXML | Out-File -FilePath "C:\EQ12\eq12_self_healing.xml" -Encoding UTF8

# Register tasks with Windows Task Scheduler
try {
    schtasks /create /tn "EQ12 Daily Maintenance" /xml "C:\EQ12\eq12_daily_maintenance.xml" /f
    schtasks /create /tn "EQ12 Health Monitor" /xml "C:\EQ12\eq12_health_monitor.xml" /f
    schtasks /create /tn "EQ12 Self-Healing" /xml "C:\EQ12\eq12_self_healing.xml" /f
    
    Write-Host "✅ EQ12 Maintenance Pack - Scheduled Tasks Created Successfully" -ForegroundColor Green
    Write-Host "📅 Daily Maintenance: 6:00 AM daily" -ForegroundColor Cyan
    Write-Host "🏥 Health Monitor: Every 4 hours" -ForegroundColor Cyan
    Write-Host "🔮 Self-Healing: Every hour" -ForegroundColor Cyan
    Write-Host "💰 Business Value Protected: `$1.9M/month" -ForegroundColor Green
    
    # Display task status
    Write-Host "`n📋 Current Task Status:" -ForegroundColor Yellow
    schtasks /query /tn "EQ12 Daily Maintenance" /fo table
    schtasks /query /tn "EQ12 Health Monitor" /fo table  
    schtasks /query /tn "EQ12 Self-Healing" /fo table
    
} catch {
    Write-Host "❌ Failed to register tasks: $($_.Exception.Message)" -ForegroundColor Red
    Write-Host "💡 Try running as Administrator or use manual XML import" -ForegroundColor Yellow
}