<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>EQ12.CommandCenter</RootNamespace>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EQ12.Core\EQ12.Core.vbproj" />
    <ProjectReference Include="..\EQ12.Security\EQ12.Security.vbproj" />
    <ProjectReference Include="..\EQ12.TelegramBot\EQ12.TelegramBot.vbproj" />
    <ProjectReference Include="..\EQ12.StackAgent\EQ12.StackAgent.vbproj" />
    <ProjectReference Include="..\EQ12.Diagnostics\EQ12.Diagnostics.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

</Project>
