{
  // ============================================================================
  // XAMPP PHP DEVELOPMENT - CLEAN SETUP (No Java Extensions)
  // ============================================================================
  
  // ============================================================================
  // PHP VALIDATION & BUILT-IN FEATURES
  // ============================================================================
  "php.validate.enable": true,
  "php.validate.executablePath": "C:/xampp/php/php.exe",
  "php.validate.run": "onSave",
  "php.suggest.basic": false,
  
  // ============================================================================
  // INTELEPHENSE CONFIGURATION
  // ============================================================================
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  
  "intelephense.files.exclude": [
    "**/.git/**",
    "**/node_modules/**", 
    "**/vendor/**",
    "**/.venv/**"
  ],
  "intelephense.format.enable": true,
  "intelephense.files.associations": ["*.php", "*.phtml"],
  
  // ============================================================================
  // FILE ASSOCIATIONS & EDITOR
  // ============================================================================
  "files.associations": {
    "*.inc": "php",
    "*.module": "php"
  },
  "editor.formatOnSave": true,
  
  // ============================================================================
  // OPTIONAL: COMPOSER SUPPORT
  // ============================================================================
  "intelephense.environment.phpVersion": "7.4"
}