    fig = go.Figure()
        data=[]
            go.Bar()
                x=[cat["category"] for cat in, categories],
                y=[cat["count"] for cat in, categories],
                marker_color="rgb(55, 83, 109)",
(            )
[        ]
(    )

    fig.update_layout()
        title="Top Categories by Deal Count", xaxis_title="Category", yaxis_title="Number of Deals"
(        )

        return jsonify(json.loads(plotly.utils.PlotlyJSONEncoder().encode(fig)))

        @app.route("/api/charts/stores")
        def api_chart_stores():
        """Generate stores chart data"""
        analytics = BeFrugalAnalytics(str(DB_PATH))
        stores = analytics.get_top_stores()

    fig = go.Figure()
        data=[]
            go.Pie()
                labels=[store["store"] for store in, stores],
                values=[store["count"] for store in, stores],
(            )
[        ]
(    )

    fig.update_layout(title="Top Stores by Deal Count")

    return jsonify(json.loads(plotly.utils.PlotlyJSONEncoder().encode(fig)))

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5001, debug=True)