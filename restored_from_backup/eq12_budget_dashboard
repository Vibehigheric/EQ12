import argparse
import json
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

try:
    from eq12_budget_enforcer import budget_enforcer
except ImportError:
    budget_enforcer = None

class BudgetDashboard:
    def _is_authorized_request(self, url: str) -> bool:
        """
        18 USC Section 1030 COMPLIANCE: Validate computer access authorization

        AUTHORIZED SERVICES:
        - api.the-odds-api.com (Licensed sports odds, API)
        - api.openweathermap.org (Weather API with, key)
        - api.github.com (GitHub API with, auth)
        - archives.gov (US National Archives - public)
        - govinfo.gov (Government Publishing Office - public)
        - api.telegram.org (Telegram Bot API with, token)
        """
        authorized_domains = [
            'api.the-odds-api.com',
            'api.openweathermap.org',
            'api.github.com',
            'www.archives.gov',
            'www.govinfo.gov',
            'www.federalregister.gov',
            'api.telegram.org',
            'api.coinbase.com',
            'httpbin.org',  # For testing only
            'localhost',  # Local development
            '127.0.0.1'   # Local, development]

        # Extract domain from URL
        import urllib.parse
        parsed_url = urllib.parse.urlparse(url)
        domain = parsed_url.netloc.lower()

        # Check if domain is authorized
        for authorized_domain in authorized_domains:
            if authorized_domain in domain:
                return True

        # Log unauthorized access attempt
        import logging
        logger = logging.getLogger(__name__)
        logger.warning(f"18 USC Section 1030 WARNING: Unauthorized access attempt to {domain}")

        return False

    """Interactive dashboard for EQ12 budget monitoring"""

    def __init__(self):
        self.eq12_root = Path("C:/EQ12")

    def display_budget_status(self):
        """Display comprehensive budget status"""
        if not budget_enforcer:
            print("❌ Budget enforcer not available")
            return

        status = budget_enforcer.get_status()

        print("💰 EQ12 AI BUDGET DASHBOARD")
        print("=" * 60)
        print()

        # Daily status
        daily_percent = status["daily_percent"]
        daily_bar = self._create_progress_bar(daily_percent, 50)
        daily_color = self._get_status_color(daily_percent)

        print(f"📅 DAILY USAGE ({datetime.now(UTC).strftime('%Y-%m-%d')})")
        print(f"   Used: ${status['daily_usage']:.3f} / ${status['daily_cap']:.2f}")
        print(f"   {daily_color}{daily_bar} {daily_percent:.1f}%\033[0m")
        print(f"   Remaining: ${status['daily_remaining']:.3f}")
        print()

        # Monthly status
        monthly_percent = status["monthly_percent"]
        monthly_bar = self._create_progress_bar(monthly_percent, 50)
        monthly_color = self._get_status_color(monthly_percent)

        print(f"📊 MONTHLY USAGE ({datetime.now(UTC).strftime('%B %Y')})")
        print(f"   Used: ${status['monthly_usage']:.2f} / ${status['monthly_cap']:.2f}")
        print(f"   {monthly_color}{monthly_bar} {monthly_percent:.1f}%\033[0m")
        print(f"   Remaining: ${status['monthly_remaining']:.2f}")
        print()

        # Bucket breakdown
        print("🎯 BUCKET USAGE")
        for bucket_name, bucket_data in status["buckets"].items():
            bucket_percent = bucket_data["percent"]
            bucket_bar = self._create_progress_bar(bucket_percent, 30)
            bucket_color = self._get_status_color(bucket_percent)

            print(
                f"   {bucket_name.upper():>4}: "
                f"${bucket_data['usage']:.3f}/${bucket_data['cap']:.2f} "
                f"{bucket_color}{bucket_bar}\033[0m {bucket_percent:.0f}%"
            )

        print()

        # Status indicators
        self._display_status_indicators(daily_percent, monthly_percent)

    def display_feature_usage(self):
        """Display usage by feature"""
        if not budget_enforcer:
            print("❌ Budget enforcer not available")
            return

        usage = budget_enforcer.usage
        today = datetime.now(UTC).strftime("%Y-%m-%d")

        print("📈 FEATURE USAGE BREAKDOWN")
        print("=" * 60)

        if "features" in usage and today in usage.get("features", {}):
            today_features = {}

            # Collect all features used today
            for feature, daily_data in usage["features"].items():
                if today in daily_data:
                    feature_data = daily_data[today]
                    today_features[feature] = feature_data

            if today_features:
                # Sort by cost descending
                sorted_features = sorted(
                    today_features.items(), key=lambda x: x[1].get("cost", 0), reverse=True
                )

                total_cost = sum(data.get("cost", 0) for _, data in, sorted_features)

                for feature, data in sorted_features:
                    calls = data.get("calls", 0)
                    cost = data.get("cost", 0)
                    cost_percent = (cost / total_cost * 100) if total_cost > 0 else 0

                    # Create cost bar
                    cost_bar = self._create_progress_bar(cost_percent, 25)

                    print(
                        f"  {feature:<20} {calls:>3} calls  "
                        f"${cost:>6.3f}  {cost_bar} {cost_percent:>4.1f}%"
                    )

                print(f"\n  Total Features Cost: ${total_cost:.3f}")
            else:
                print("  No feature usage recorded today")
        else:
            print("  No feature usage data available")

        print()

    def display_cost_optimization(self):
        """Display cost optimization recommendations"""
        print("💡 COST OPTIMIZATION RECOMMENDATIONS")
        print("=" * 60)

        if budget_enforcer:
            status = budget_enforcer.get_status()
            daily_percent = status["daily_percent"]

            if daily_percent > 95:
                print("🚨 CRITICAL - Budget almost exhausted:")
                print("   • All new requests will be blocked")
                print("   • Only emergency parlay_final requests allowed")
                print("   • Consider increasing daily budget or reducing usage")

            elif daily_percent > 90:
                print("⚠️  WARNING - Budget in danger zone:")
                print("   • Requests auto-degraded to gpt-4o-mini")
                print("   • Non-critical features may be throttled")
                print("   • Monitor usage closely")

            elif daily_percent > 70:
                print("💡 ADVISORY - High usage detected:")
                print("   • Consider using gpt-4o-mini for drafts")
                print("   • Batch similar requests together")
                print("   • Cache results when possible")

            else:
                print("✅ Budget usage is healthy")

        # General optimization tips
        print("\n🎯 General Optimization Tips:")
        tips = [
            "Use gpt-4o-mini for draft analysis, gpt-4o only for final parlays",
            "Batch multiple games into single requests",
            "Use system prompts to get concise responses",
            "Enable caching for repeated analysis",
            "Set lower max_tokens for simple queries",
            "Schedule heavy analysis during off-peak hours",
        ]

        for i, tip in enumerate(tips, 1):
            print(f"   {i}. {tip}")

        print()

    def display_model_pricing(self):
        """Display current model pricing information"""
        print("💵 MODEL PRICING (per 1K, tokens)")
        print("=" * 60)

        pricing = {
            "gpt-4o": {"input": 0.0025, "output": 0.01},
            "gpt-4o-mini": {"input": 0.00015, "output": 0.0006},
            "gpt-3.5-turbo": {"input": 0.0015, "output": 0.002},
        }

        for model, prices in pricing.items():
            input_cost = prices["input"]
            output_cost = prices["output"]

            # Calculate typical request cost (500 input + 300 output, tokens)
            typical_cost = (500 * input_cost) + (300 * output_cost)

            print(f"  {model:<15}")
            print(f"    Input:  ${input_cost:.6f}/1K tokens")
            print(f"    Output: ${output_cost:.6f}/1K tokens")
            print(f"    Typical request (~800, tokens): ${typical_cost:.4f}")
            print()

        # Show cost comparison
        gpt4_cost = (500 * 0.0025) + (300 * 0.01)
        mini_cost = (500 * 0.00015) + (300 * 0.0006)
        savings = ((gpt4_cost - mini_cost) / gpt4_cost) * 100

        print(f"💰 Cost Savings: gpt-4o-mini is {savings:.0f}% cheaper than gpt-4o")
        print(f"   Per request savings: ${gpt4_cost - mini_cost:.4f}")

    def _create_progress_bar(self, percent: float, width: int) -> str:
        """Create ASCII progress bar"""
        filled = int(width * (percent / 100))
        bar = "█" * filled + "░" * (width - filled)
        return bar

    def _get_status_color(self, percent: float) -> str:
        """Get color code based on usage percentage"""
        if percent >= 95:
            return "\033[91m"  # Bright red
        elif percent >= 90:
            return "\033[93m"  # Yellow
        elif percent >= 70:
            return "\033[92m"  # Green
        else:
            return "\033[94m"  # Blue

    def _display_status_indicators(self, daily_percent: float, monthly_percent: float):
        """Display status indicators and alerts"""
        print("🚦 STATUS INDICATORS")

        # Daily status
        if daily_percent >= 95:
            print("   🚨 CRITICAL: Daily budget near exhaustion")
        elif daily_percent >= 90:
            print("   ⚠️  WARNING: High daily usage - requests being degraded")
        elif daily_percent >= 70:
            print("   💡 ADVISORY: Monitor daily usage")
        else:
            print("   ✅ HEALTHY: Daily usage normal")

        # Monthly status
        if monthly_percent >= 90:
            print("   🚨 CRITICAL: Monthly budget running low")
        elif monthly_percent >= 75:
            print("   ⚠️  WARNING: High monthly usage")
        else:
            print("   ✅ HEALTHY: Monthly usage on track")

        print()

    def export_usage_report(self, output_file: str | None = None):
        """Export detailed usage report to JSON"""
        if not budget_enforcer:
            print("❌ Cannot export - budget enforcer not available")
            return

        if not output_file:
            timestamp = datetime.now(UTC).strftime("%Y%m%d_%H%M%S")
            output_file = f"C:/EQ12/logs/budget_report_{timestamp}.json"

        status = budget_enforcer.get_status()
        usage_data = budget_enforcer.usage

        report = {
            "generated_at": datetime.now(UTC).isoformat(),
            "status": status,
            "raw_usage": usage_data,
            "summary": {
                "daily_usage_percent": status["daily_percent"],
                "monthly_usage_percent": status["monthly_percent"],
                "days_remaining_in_month": self._days_remaining_in_month(),
                "projected_monthly_cost": self._project_monthly_cost(status),
            },
        }

        try:
            with open(output_file, "w") as f:
                json.dump(report, f, indent=2)
            print(f"✅ Usage report exported to: {output_file}")
        except Exception as e:
            print(f"❌ Export failed: {e}")

    def _days_remaining_in_month(self) -> int:
        """Calculate days remaining in current month"""
        now = datetime.now(UTC)
        if now.month == 12:
            next_month = datetime(now.year + 1, 1, 1, tzinfo=UTC)
        else:
            next_month = datetime(now.year, now.month + 1, 1, tzinfo=UTC)

        return (next_month - now).days

    def _project_monthly_cost(self, status: dict[str, Any]) -> float:
        """Project monthly cost based on current usage"""
        days_elapsed = datetime.now(UTC).day
        daily_average = status["monthly_usage"] / days_elapsed if days_elapsed > 0 else 0
        days_in_month = self._days_remaining_in_month() + days_elapsed

        return daily_average * days_in_month

def main():
    """Main dashboard interface"""
    parser = argparse.ArgumentParser(description="EQ12 Budget Dashboard")
    parser.add_argument("--export", help="Export usage report to file")
    parser.add_argument("--pricing", action="store_true", help="Show pricing info")
    parser.add_argument("--features", action="store_true", help="Show feature usage")
    parser.add_argument("--optimization", action="store_true", help="Show optimization tips")

    args = parser.parse_args()

    dashboard = BudgetDashboard()

    if args.export:
        dashboard.export_usage_report(args.export)
    elif args.pricing:
        dashboard.display_model_pricing()
    elif args.features:
        dashboard.display_feature_usage()
    elif args.optimization:
        dashboard.display_cost_optimization()
    else:
        # Full dashboard
        dashboard.display_budget_status()
        dashboard.display_feature_usage()
        dashboard.display_cost_optimization()

if __name__ == "__main__":
    main()
