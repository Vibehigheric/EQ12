import http.server
import socketserver
import webbrowser
import os
import sys
from pathlib import Path

def main():
    # Set the directory to the dashboard folder
    dashboard_dir = Path(__file__).parent
    os.chdir(dashboard_dir)

    # Try different ports if one is in use
    ports_to_try = [9000, 8080, 8081, 9001]
    server = None
    port = None

    for try_port in ports_to_try:
        try:
            handler = http.server.SimpleHTTPRequestHandler
            server = socketserver.TCPServer(("", try_port), handler)
            port = try_port
            break
        except OSError:
            continue

    if server is None:
        print("❌ Could not find an available port. Please check if other servers are running.")
        sys.exit(1)

    print("🚀 EQ12 Unified Enterprise Dashboard Server Starting...")
    print(f"📊 Dashboard URL: http://localhost:{port}/test_dashboard.html")
    print(f"🎯 ControlTech Jobs: Advanced Boolean search for Buffalo NY 14215")
    print(f"💰 Business Metrics: Live performance analytics with break-even analysis")
    print(f"🤖 AI Betting: Intelligent prediction engine with Kelly Criterion")
    print(f"📈 Real-time Data: Crypto, Stocks, Sports, API monitoring")
    print("\n🔥 Press Ctrl+C to stop the server")

    # Automatically open the dashboard in the default browser
    try:
        webbrowser.open(f"http://localhost:{port}/test_dashboard.html")
        print("🌐 Dashboard opened in your default browser")
    except:
        print("⚠️ Could not auto-open browser. Please navigate to the URL manually.")

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n🛑 Server stopped by user")
        server.shutdown()

if __name__ == "__main__":
    main()
