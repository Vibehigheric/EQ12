    def get_monthly_spending(self, provider: Optional[str] = None) -> Dict[str, float]:
        """Get current month spending by provider"""

        current_month = datetime.now().strftime("%Y-%m")
        monthly_spending = {}

        # Calculate from daily usage
        for date, daily_data in self.usage_data["daily_usage"].items():
            if date.startswith(current_month):
                if provider:
                    if provider in daily_data["providers"]:
                        monthly_spending[provider] = \
                            monthly_spending.get(provider, 0) + \
                            daily_data["providers"][provider]["cost"]
                else:
                    for p, p_data in daily_data["providers"].items():
                        monthly_spending[p] = \
                            monthly_spending.get(p, 0) + p_data["cost"]

        return monthly_spending

