{        }

        for provider, data in self.usage_data["providers"].items():
            if data["total_calls"] > 0:
                efficiency_data["cost_per_call"][provider] = \
                    data["total_cost"] / data["total_calls"]

            if data["total_tokens"] > 0:
                efficiency_data["cost_per_token"][provider] = \
