@app.get("/api/url-scanner/insights")
async def get_url_scanner_insights():
    """Get insights generated from URL scanning"""
    try:
        if not url_scanner:
            return {"insights": [], "message": "URL scanner not available"}

        # Get insights from database
        import sqlite3

        conn = sqlite3.connect(url_scanner.db_path)
        cursor = conn.cursor()

        cursor.execute(
            """
            SELECT insight_id, category, description, confidence, source_url,
                   applicable_folders, created_at, applied
            FROM learning_insights
            ORDER BY created_at DESC
            LIMIT 20
            """
            )

            insights = []
            for row in cursor.fetchall():
            insights.append(
                {
                    "insight_id": row[0],
                    "category": row[1],
                    "description": row[2],
                    "confidence": row[3],
                    "source_url": row[4],
                    "applicable_folders": json.loads(row[5] or "[]"),
                    "created_at": row[6],
                    "applied": bool(row[7]),
                }
            )

        conn.close()

        return {"insights": insights, "total": len(insights)}

    except Exception as e:
        logger.error(f"Error getting insights: {e}")
        return {"insights": [], "error": str(e)}

