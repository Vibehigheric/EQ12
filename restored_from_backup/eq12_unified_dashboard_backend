# Background task to update dashboard data
async def update_dashboard_data():
    """Background task to refresh dashboard data"""
    while True:
        try:
            logger.info("Updating dashboard data...")

            # Update all data sources
            await check_all_services()
            load_betting_data()
            load_finance_data()
            load_automation_data()
            load_ai_data()
            load_url_scanner_data()

            dashboard_state.last_updated = datetime.now(UTC)

            # Log metrics to database
            log_dashboard_metrics()

        except Exception as e:
            logger.error(f"Error updating dashboard data: {e}")

        # Wait 30 seconds before next update
        await asyncio.sleep(30)

