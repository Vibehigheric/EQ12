import re
import json
from pathlib import Path

def validate_dashboard_data_quality():
    """Validate dashboard test result consistency"""
    dashboard_path = Path("C:/EQ12/dashboard/test_dashboard.html")

    if not dashboard_path.exists():
        print(" Dashboard file not found")
        return False

    with open(dashboard_path, 'r', encoding='utf-8') as f:
        content = f.read()

    issues_found = []

    # Check for hardcoded inconsistent test results
    hardcoded_fails = content.count(" Failed test: FAIL")
    if hardcoded_fails > 0:
        issues_found.append(f"Found {hardcoded_fails} hardcoded 'Failed test: FAIL' entries")

    # Check for weather API test definition
    if "'sports-weather-api'" in content:
        if "Weather API connection: PASS" in content:
            print(" Weather API test properly defined")
        else:
            issues_found.append("Weather API test missing proper definition")

    # Check for parlay builder test definition
    if "'sports-parlay-builder'" in content:
        if "10-leg parlay generation: PASS" in content:
            print(" Parlay builder test properly defined")
        else:
            issues_found.append("Parlay builder test missing proper definition")

    # Check for consistent result containers
    if "parlay-builder-result" in content:
        print(" Parlay builder has dedicated result container")
    else:
        issues_found.append("Parlay builder missing dedicated result container")

    # Summary
    if issues_found:
        print("\n DATA QUALITY ISSUES FOUND:")
        for issue in issues_found:
            print(f"  - {issue}")
        return False
    else:
        print("\n ALL DATA QUALITY CHECKS PASSED!")
        print("  - Test result consistency: FIXED")
        print("  - Weather API test: DEFINED")
        print("  - Parlay builder test: DEFINED")
        print("  - Result containers: PROPERLY MAPPED")
        return True

if __name__ == "__main__":
    print(" EQ12 Dashboard Data Quality Validation")
    print("=" * 50)

    success = validate_dashboard_data_quality()

    if success:
        print("\n Dashboard data quality issues have been RESOLVED!")
    else:
        print("\n  Additional fixes may be needed")

