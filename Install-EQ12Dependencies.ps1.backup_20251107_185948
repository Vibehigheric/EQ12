#!/usr/bin/env powershell\n# EQ12 Automated Dependency Scanner and Installer\n# Free-Tier Focus: Zero-cost setup for maximum EQ12 functionality\n# Usage: .\\Install-EQ12Dependencies.ps1 [-WhatIf] [-Verbose] [-InstallAll]\n\n[CmdletBinding()]\nParam(\n    [switch]$WhatIf,\n    [switch]$InstallAll,\n    [string]$LogPath = \"C:\\EQ12\\logs\\dependency-install.log\"\n)\n\n# Ensure logs directory exists\n$LogDir = Split-Path $LogPath -Parent\nif (!(Test-Path $LogDir)) {\n    New-Item -Path $LogDir -ItemType Directory -Force | Out-Null\n}\n\n# Logging function\nfunction Write-Log {\n    param([string]$Message, [string]$Level = \"INFO\")\n    $Timestamp = Get-Date -Format \"yyyy-MM-dd HH:mm:ss\"\n    $LogEntry = \"[$Timestamp] [$Level] $Message\"\n    Write-Host $LogEntry\n    Add-Content -Path $LogPath -Value $LogEntry\n}\n\n# Dependency check functions\nfunction Test-DotNetSDK {\n    try {\n        $dotnetVersion = & dotnet --version 2>&1\n        if ($LASTEXITCODE -eq 0) {\n            Write-Log \"✅ .NET SDK found: $dotnetVersion\"\n            return $true\n        }\n    } catch {\n        Write-Log \"❌ .NET SDK not found\" \"ERROR\"\n        return $false\n    }\n}\n\nfunction Install-DotNetSDK {\n    Write-Log \"📦 Installing .NET 8 SDK...\"\n    if ($WhatIf) {\n        Write-Log \"[WHATIF] Would install .NET 8 SDK\" \"INFO\"\n        return\n    }\n    \n    try {\n        # Download and install .NET SDK\n        $installerUrl = \"https://download.visualstudio.microsoft.com/download/pr/93ca4f11-7f3e-4b8c-8c2d-3e1f3d4e5f6a/1234567890abcdef/dotnet-sdk-8.0.100-win-x64.exe\"\n        $installerPath = \"$env:TEMP\\dotnet-sdk-installer.exe\"\n        \n        Write-Log \"Downloading .NET SDK installer...\"\n        Invoke-WebRequest -Uri $installerUrl -OutFile $installerPath\n        \n        Write-Log \"Running .NET SDK installer...\"\n        Start-Process -FilePath $installerPath -ArgumentList \"/quiet\" -Wait\n        \n        # Refresh environment variables\n        $env:PATH = [System.Environment]::GetEnvironmentVariable(\"PATH\",\"Machine\") + \";\" + [System.Environment]::GetEnvironmentVariable(\"PATH\",\"User\")\n        \n        Write-Log \"✅ .NET SDK installation completed\"\n    } catch {\n        Write-Log \"❌ .NET SDK installation failed: $($_.Exception.Message)\" \"ERROR\"\n    }\n}\n\nfunction Test-Python {\n    try {\n        $pythonVersion = & python --version 2>&1\n        if ($LASTEXITCODE -eq 0 -and $pythonVersion -match \"Python 3\\.(9|10|11|12)\") {\n            Write-Log \"✅ Python found: $pythonVersion\"\n            return $true\n        } else {\n            Write-Log \"⚠️ Python found but version may be incompatible: $pythonVersion\" \"WARN\"\n            return $false\n        }\n    } catch {\n        Write-Log \"❌ Python not found\" \"ERROR\"\n        return $false\n    }\n}\n\nfunction Install-Python {\n    Write-Log \"📦 Installing Python 3.11...\"\n    if ($WhatIf) {\n        Write-Log \"[WHATIF] Would install Python 3.11\" \"INFO\"\n        return\n    }\n    \n    try {\n        # Use winget to install Python\n        if (Get-Command winget -ErrorAction SilentlyContinue) {\n            Write-Log \"Installing Python via winget...\"\n            & winget install Python.Python.3.11 --silent --accept-package-agreements\n        } else {\n            # Fallback to direct download\n            $pythonUrl = \"https://www.python.org/ftp/python/3.11.6/python-3.11.6-amd64.exe\"\n            $pythonInstaller = \"$env:TEMP\\python-installer.exe\"\n            \n            Write-Log \"Downloading Python installer...\"\n            Invoke-WebRequest -Uri $pythonUrl -OutFile $pythonInstaller\n            \n            Write-Log \"Running Python installer...\"\n            Start-Process -FilePath $pythonInstaller -ArgumentList \"/quiet\", \"InstallAllUsers=1\", \"PrependPath=1\", \"Include_test=0\" -Wait\n        }\n        \n        # Refresh PATH\n        $env:PATH = [System.Environment]::GetEnvironmentVariable(\"PATH\",\"Machine\") + \";\" + [System.Environment]::GetEnvironmentVariable(\"PATH\",\"User\")\n        \n        Write-Log \"✅ Python installation completed\"\n    } catch {\n        Write-Log \"❌ Python installation failed: $($_.Exception.Message)\" \"ERROR\"\n    }\n}\n\nfunction Test-Git {\n    try {\n        $gitVersion = & git --version 2>&1\n        if ($LASTEXITCODE -eq 0) {\n            Write-Log \"✅ Git found: $gitVersion\"\n            return $true\n        }\n    } catch {\n        Write-Log \"❌ Git not found\" \"ERROR\"\n        return $false\n    }\n}\n\nfunction Install-Git {\n    Write-Log \"📦 Installing Git...\"\n    if ($WhatIf) {\n        Write-Log \"[WHATIF] Would install Git\" \"INFO\"\n        return\n    }\n    \n    try {\n        if (Get-Command winget -ErrorAction SilentlyContinue) {\n            & winget install Git.Git --silent --accept-package-agreements\n        } else {\n            $gitUrl = \"https://github.com/git-for-windows/git/releases/latest/download/Git-2.42.0.2-64-bit.exe\"\n            $gitInstaller = \"$env:TEMP\\git-installer.exe\"\n            \n            Invoke-WebRequest -Uri $gitUrl -OutFile $gitInstaller\n            Start-Process -FilePath $gitInstaller -ArgumentList \"/VERYSILENT\", \"/NORESTART\" -Wait\n        }\n        \n        Write-Log \"✅ Git installation completed\"\n    } catch {\n        Write-Log \"❌ Git installation failed: $($_.Exception.Message)\" \"ERROR\"\n    }\n}\n\nfunction Test-VSCode {\n    try {\n        $codePath = Get-Command code -ErrorAction SilentlyContinue\n        if ($codePath) {\n            Write-Log \"✅ VS Code found: $($codePath.Source)\"\n            return $true\n        }\n    } catch {}\n    \n    Write-Log \"❌ VS Code not found\" \"ERROR\"\n    return $false\n}\n\nfunction Install-VSCode {\n    Write-Log \"📦 Installing Visual Studio Code...\"\n    if ($WhatIf) {\n        Write-Log \"[WHATIF] Would install VS Code\" \"INFO\"\n        return\n    }\n    \n    try {\n        if (Get-Command winget -ErrorAction SilentlyContinue) {\n            & winget install Microsoft.VisualStudioCode --silent --accept-package-agreements\n        } else {\n            $vscodeUrl = \"https://code.visualstudio.com/sha/download?build=stable&os=win32-x64\"\n            $vscodeInstaller = \"$env:TEMP\\vscode-installer.exe\"\n            \n            Invoke-WebRequest -Uri $vscodeUrl -OutFile $vscodeInstaller\n            Start-Process -FilePath $vscodeInstaller -ArgumentList \"/VERYSILENT\", \"/NORESTART\", \"/MERGETASKS=!runcode\" -Wait\n        }\n        \n        Write-Log \"✅ VS Code installation completed\"\n    } catch {\n        Write-Log \"❌ VS Code installation failed: $($_.Exception.Message)\" \"ERROR\"\n    }\n}\n\nfunction Test-Docker {\n    try {\n        $dockerVersion = & docker --version 2>&1\n        if ($LASTEXITCODE -eq 0) {\n            Write-Log \"✅ Docker found: $dockerVersion\"\n            return $true\n        }\n    } catch {\n        Write-Log \"❌ Docker not found\" \"ERROR\"\n        return $false\n    }\n}\n\nfunction Install-Docker {\n    Write-Log \"📦 Installing Docker Desktop (requires manual approval)...\"\n    if ($WhatIf) {\n        Write-Log \"[WHATIF] Would install Docker Desktop\" \"INFO\"\n        return\n    }\n    \n    try {\n        Write-Log \"⚠️ Docker Desktop requires Windows 10/11 Pro or Enterprise with Hyper-V\" \"WARN\"\n        \n        if (Get-Command winget -ErrorAction SilentlyContinue) {\n            & winget install Docker.DockerDesktop --silent --accept-package-agreements\n        } else {\n            $dockerUrl = \"https://desktop.docker.com/win/main/amd64/Docker%20Desktop%20Installer.exe\"\n            $dockerInstaller = \"$env:TEMP\\docker-desktop-installer.exe\"\n            \n            Invoke-WebRequest -Uri $dockerUrl -OutFile $dockerInstaller\n            Write-Log \"⚠️ Starting Docker Desktop installer - manual intervention may be required\"\n            Start-Process -FilePath $dockerInstaller -ArgumentList \"install\", \"--quiet\" -Wait\n        }\n        \n        Write-Log \"✅ Docker Desktop installation initiated (restart may be required)\"\n        Write-Log \"⚠️ Docker Desktop will need to be started manually after installation\" \"WARN\"\n    } catch {\n        Write-Log \"❌ Docker Desktop installation failed: $($_.Exception.Message)\" \"ERROR\"\n    }\n}\n\nfunction Test-GCloudCLI {\n    try {\n        $gcloudVersion = & gcloud version --quiet 2>&1\n        if ($LASTEXITCODE -eq 0) {\n            Write-Log \"✅ Google Cloud CLI found\"\n            return $true\n        }\n    } catch {\n        Write-Log \"❌ Google Cloud CLI not found\" \"ERROR\"\n        return $false\n    }\n}\n\nfunction Install-GCloudCLI {\n    Write-Log \"📦 Installing Google Cloud CLI...\"\n    if ($WhatIf) {\n        Write-Log \"[WHATIF] Would install Google Cloud CLI\" \"INFO\"\n        return\n    }\n    \n    try {\n        $gcloudUrl = \"https://dl.google.com/dl/cloudsdk/channels/rapid/GoogleCloudSDKInstaller.exe\"\n        $gcloudInstaller = \"$env:TEMP\\gcloud-installer.exe\"\n        \n        Write-Log \"Downloading Google Cloud SDK installer...\"\n        Invoke-WebRequest -Uri $gcloudUrl -OutFile $gcloudInstaller\n        \n        Write-Log \"Running Google Cloud SDK installer...\"\n        Start-Process -FilePath $gcloudInstaller -ArgumentList \"/S\" -Wait\n        \n        Write-Log \"✅ Google Cloud CLI installation completed\"\n        Write-Log \"⚠️ Run 'gcloud init' to configure authentication\" \"WARN\"\n    } catch {\n        Write-Log \"❌ Google Cloud CLI installation failed: $($_.Exception.Message)\" \"ERROR\"\n    }\n}\n\nfunction Install-PythonPackages {\n    Write-Log \"📦 Installing Python packages for EQ12...\"\n    \n    $requiredPackages = @(\n        \"google-cloud-bigquery>=3.0.0\",\n        \"google-cloud-storage>=2.0.0\",\n        \"google-cloud-secret-manager>=2.0.0\",\n        \"requests>=2.25.0\",\n        \"pandas>=1.3.0\",\n        \"numpy>=1.20.0\",\n        \"beautifulsoup4>=4.9.0\",\n        \"selenium>=4.0.0\",\n        \"feedparser>=6.0.0\",\n        \"flask>=2.0.0\",\n        \"flask-socketio>=5.0.0\",\n        \"psutil>=5.8.0\",\n        \"schedule>=1.1.0\",\n        \"python-telegram-bot>=20.0\",\n        \"sqlalchemy>=1.4.0\",\n        \"python-dotenv>=0.19.0\"\n    )\n    \n    if ($WhatIf) {\n        Write-Log \"[WHATIF] Would install Python packages: $($requiredPackages -join ', ')\" \"INFO\"\n        return\n    }\n    \n    foreach ($package in $requiredPackages) {\n        try {\n            Write-Log \"Installing $package...\"\n            & python -m pip install $package --quiet --no-warn-script-location\n            if ($LASTEXITCODE -eq 0) {\n                Write-Log \"✅ $package installed successfully\"\n            } else {\n                Write-Log \"❌ Failed to install $package\" \"ERROR\"\n            }\n        } catch {\n            Write-Log \"❌ Exception installing $package : $($_.Exception.Message)\" \"ERROR\"\n        }\n    }\n}\n\nfunction Test-VSCodeExtensions {\n    Write-Log \"🔍 Checking recommended VS Code extensions...\"\n    \n    $recommendedExtensions = @(\n        \"ms-python.python\",\n        \"ms-vscode.vscode-json\",\n        \"ms-vscode.powershell\",\n        \"ms-dotnettools.vscode-dotnet-runtime\",\n        \"GitHub.copilot\",\n        \"ms-vscode.vscode-docker\"\n    )\n    \n    $installedExtensions = @()\n    try {\n        $installedExtensions = & code --list-extensions 2>&1\n    } catch {\n        Write-Log \"⚠️ Could not check VS Code extensions (VS Code may not be installed)\" \"WARN\"\n        return\n    }\n    \n    foreach ($extension in $recommendedExtensions) {\n        if ($installedExtensions -contains $extension) {\n            Write-Log \"✅ VS Code extension installed: $extension\"\n        } else {\n            Write-Log \"❌ VS Code extension missing: $extension\"\n            \n            if ($InstallAll -and !$WhatIf) {\n                Write-Log \"Installing VS Code extension: $extension\"\n                & code --install-extension $extension --force\n            } elseif ($WhatIf) {\n                Write-Log \"[WHATIF] Would install VS Code extension: $extension\" \"INFO\"\n            }\n        }\n    }\n}\n\nfunction Test-WindowsFeatures {\n    Write-Log \"🔍 Checking Windows features...\"\n    \n    # Check for Windows Subsystem for Linux (optional but useful)\n    $wslFeature = Get-WindowsOptionalFeature -Online -FeatureName Microsoft-Windows-Subsystem-Linux -ErrorAction SilentlyContinue\n    if ($wslFeature -and $wslFeature.State -eq \"Enabled\") {\n        Write-Log \"✅ Windows Subsystem for Linux (WSL) is enabled\"\n    } else {\n        Write-Log \"⚠️ Windows Subsystem for Linux (WSL) is not enabled (optional for EQ12)\" \"WARN\"\n        \n        if ($InstallAll -and !$WhatIf) {\n            Write-Log \"Enabling WSL...\"\n            Enable-WindowsOptionalFeature -Online -FeatureName Microsoft-Windows-Subsystem-Linux -NoRestart\n        } elseif ($WhatIf) {\n            Write-Log \"[WHATIF] Would enable Windows Subsystem for Linux\" \"INFO\"\n        }\n    }\n    \n    # Check Hyper-V for Docker (Windows Pro/Enterprise only)\n    $hyperVFeature = Get-WindowsOptionalFeature -Online -FeatureName Microsoft-Hyper-V -ErrorAction SilentlyContinue\n    if ($hyperVFeature -and $hyperVFeature.State -eq \"Enabled\") {\n        Write-Log \"✅ Hyper-V is enabled (required for Docker Desktop)\"\n    } else {\n        $windowsEdition = (Get-ComputerInfo).WindowsProductName\n        if ($windowsEdition -match \"Pro|Enterprise|Education\") {\n            Write-Log \"⚠️ Hyper-V is not enabled but supported on $windowsEdition\" \"WARN\"\n            \n            if ($InstallAll -and !$WhatIf) {\n                Write-Log \"Enabling Hyper-V (requires restart)...\"\n                Enable-WindowsOptionalFeature -Online -FeatureName Microsoft-Hyper-V -All -NoRestart\n            } elseif ($WhatIf) {\n                Write-Log \"[WHATIF] Would enable Hyper-V\" \"INFO\"\n            }\n        } else {\n            Write-Log \"⚠️ Hyper-V not available on $windowsEdition (Docker Desktop will use WSL2)\" \"WARN\"\n        }\n    }\n}\n\nfunction Initialize-EQ12Workspace {\n    Write-Log \"🏗️ Initializing EQ12 workspace structure...\"\n    \n    $eq12Directories = @(\n        \"C:\\EQ12\",\n        \"C:\\EQ12\\Data\",\n        \"C:\\EQ12\\logs\",\n        \"C:\\EQ12\\configs\",\n        \"C:\\EQ12\\scripts\",\n        \"C:\\EQ12\\tests\",\n        \"C:\\EQ12\\docs\",\n        \"C:\\EQ12\\infra\",\n        \"C:\\EQ12\\sql\",\n        \"C:\\EQ12\\dashboard\"\n    )\n    \n    foreach ($directory in $eq12Directories) {\n        if (!(Test-Path $directory)) {\n            if ($WhatIf) {\n                Write-Log \"[WHATIF] Would create directory: $directory\" \"INFO\"\n            } else {\n                New-Item -Path $directory -ItemType Directory -Force | Out-Null\n                Write-Log \"✅ Created directory: $directory\"\n            }\n        } else {\n            Write-Log \"✅ Directory exists: $directory\"\n        }\n    }\n    \n    # Create basic config file if it doesn't exist\n    $configFile = \"C:\\EQ12\\configs\\config.json\"\n    if (!(Test-Path $configFile) -and !$WhatIf) {\n        $basicConfig = @{\n            \"environment\" = \"development\"\n            \"logging\" = @{\n                \"level\" = \"INFO\"\n                \"path\" = \"C:\\EQ12\\logs\"\n            }\n            \"gcp\" = @{\n                \"project_id\" = \"eq12-sports-betting\"\n                \"region\" = \"us-central1\"\n            }\n            \"scribd\" = @{\n                \"enabled\" = $true\n                \"bucket\" = \"eq12-docs\"\n                \"bq_dataset\" = \"eq12_dw\"\n                \"bq_table\" = \"scribd_docs\"\n            }\n            \"free_tier_monitoring\" = @{\n                \"enabled\" = $true\n                \"alert_threshold_pct\" = 80\n                \"services\" = @(\n                    \"bigquery\",\n                    \"cloud_storage\",\n                    \"cloud_run\",\n                    \"openai\",\n                    \"bitly\"\n                )\n            }\n        } | ConvertTo-Json -Depth 10\n        \n        Set-Content -Path $configFile -Value $basicConfig\n        Write-Log \"✅ Created basic config file: $configFile\"\n    }\n}\n\nfunction Show-PostInstallInstructions {\n    Write-Log \"\" \"INFO\"\n    Write-Log \"🎉 EQ12 Dependency Installation Summary\" \"INFO\"\n    Write-Log \"═══════════════════════════════════════\" \"INFO\"\n    Write-Log \"\" \"INFO\"\n    Write-Log \"✅ Core dependencies have been installed/verified\" \"INFO\"\n    Write-Log \"\" \"INFO\"\n    Write-Log \"📋 Next Steps:\" \"INFO\"\n    Write-Log \"1. Restart your terminal/PowerShell session to refresh PATH\" \"INFO\"\n    Write-Log \"2. Run 'gcloud init' to configure Google Cloud authentication\" \"INFO\"\n    Write-Log \"3. Set up your EQ12 environment variables:\" \"INFO\"\n    Write-Log \"   - ODDS_API_KEY (The Odds API)\" \"INFO\"\n    Write-Log \"   - OPENAI_API_KEY (OpenAI)\" \"INFO\"\n    Write-Log \"   - TELEGRAM_BOT_TOKEN (Telegram Bot)\" \"INFO\"\n    Write-Log \"   - BITLY_ACCESS_TOKEN (Bitly)\" \"INFO\"\n    Write-Log \"4. Initialize Google Cloud Project:\" \"INFO\"\n    Write-Log \"   cd C:\\EQ12\\infra && terraform init && terraform plan\" \"INFO\"\n    Write-Log \"5. Test EQ12 CLI:\" \"INFO\"\n    Write-Log \"   Eq12Cli.exe dependency-scan\" \"INFO\"\n    Write-Log \"\" \"INFO\"\n    Write-Log \"📚 Documentation:\" \"INFO\"\n    Write-Log \"- Configuration: C:\\EQ12\\configs\\config.json\" \"INFO\"\n    Write-Log \"- Data Feed Inventory: C:\\EQ12\\docs\\EQ12_Data_Feed_Inventory_Complete.md\" \"INFO\"\n    Write-Log \"- Logs: C:\\EQ12\\logs\\\" \"INFO\"\n    Write-Log \"\" \"INFO\"\n    Write-Log \"💰 Free Tier Optimization:\" \"INFO\"\n    Write-Log \"- Monitor usage: Eq12Cli.exe free-tier-status\" \"INFO\"\n    Write-Log \"- Check feed health: Eq12Cli.exe feed-health\" \"INFO\"\n    Write-Log \"\" \"INFO\"\n    Write-Log \"🚀 Ready to start generating revenue with EQ12!\" \"INFO\"\n}\n\n# Main execution\nWrite-Log \"🔍 Starting EQ12 Dependency Scanner and Installer\"\nWrite-Log \"═════════════════════════════════════════════════\"\n\nif ($WhatIf) {\n    Write-Log \"🔮 WHATIF MODE: No actual installations will be performed\" \"WARN\"\n}\n\n# Initialize workspace structure first\nInitialize-EQ12Workspace\n\n# Core development tools\nif (!(Test-DotNetSDK)) {\n    if ($InstallAll -or (Read-Host \"Install .NET SDK? (y/N)\") -eq 'y') {\n        Install-DotNetSDK\n    }\n}\n\nif (!(Test-Python)) {\n    if ($InstallAll -or (Read-Host \"Install Python 3.11? (y/N)\") -eq 'y') {\n        Install-Python\n        Install-PythonPackages\n    }\n} else {\n    # Python exists, just install packages\n    if ($InstallAll -or (Read-Host \"Install/update Python packages? (y/N)\") -eq 'y') {\n        Install-PythonPackages\n    }\n}\n\nif (!(Test-Git)) {\n    if ($InstallAll -or (Read-Host \"Install Git? (y/N)\") -eq 'y') {\n        Install-Git\n    }\n}\n\nif (!(Test-VSCode)) {\n    if ($InstallAll -or (Read-Host \"Install Visual Studio Code? (y/N)\") -eq 'y') {\n        Install-VSCode\n    }\n}\n\n# Check VS Code extensions\nTest-VSCodeExtensions\n\n# Optional but recommended tools\nif (!(Test-Docker)) {\n    if ($InstallAll -or (Read-Host \"Install Docker Desktop? (y/N)\") -eq 'y') {\n        Install-Docker\n    }\n}\n\nif (!(Test-GCloudCLI)) {\n    if ($InstallAll -or (Read-Host \"Install Google Cloud CLI? (y/N)\") -eq 'y') {\n        Install-GCloudCLI\n    }\n}\n\n# Check Windows features\nTest-WindowsFeatures\n\n# Show summary and next steps\nShow-PostInstallInstructions\n\nWrite-Log \"🏁 EQ12 dependency installation completed!\"\nWrite-Log \"📄 Full log saved to: $LogPath\"
