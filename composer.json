{
    "name": "eq12/php-betting-platform",
    "description": "EQ12 Enhanced PHP Sports Betting Automation Platform",
    "version": "1.0.0",
    "type": "project",
    "keywords": [
        "sports-betting",
        "odds-api",
        "arbitrage",
        "betting-automation",
        "eq12",
        "php",
        "sports-analytics"
    ],
    "authors": [
        {
            "name": "EQ12 Platform",
            "email": "platform@eq12.com"
        }
    ],
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "phpstan/phpstan": "^1.0",
        "squizlabs/php_codesniffer": "^3.6",
        "friendsofphp/php-cs-fixer": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "EQ12\\": "src/"
        },
        "files": [
            "eq12_php_odds_client.php",
            "eq12_php_betting_suite.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "EQ12\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs:fix": "php-cs-fixer fix --allow-risky=yes",
        "cs:check": "phpcs --standard=PSR12 --extensions=php .",
        "test": "phpunit --colors=always",
        "demo": "C:/xampp/php/php.exe eq12_php_betting_suite.php",
        "odds-client": "C:/xampp/php/php.exe eq12_php_odds_client.php",
        "nfl-analysis": "C:/xampp/php/php.exe -r \"require 'eq12_php_betting_suite.php'; $suite = new EQ12PhpBettingSuite(); $suite->nflSundayAnalysis();\"",
        "arbitrage": "C:/xampp/php/php.exe -r \"require 'eq12_php_odds_client.php'; $client = new EQ12PhpOddsClient(); $client->findArbitrageOpportunities();\"",
        "sports": "C:/xampp/php/php.exe -r \"require 'eq12_php_odds_client.php'; $client = new EQ12PhpOddsClient(); $client->getSports();\"",
        "props": "C:/xampp/php/php.exe -r \"require 'eq12_php_odds_client.php'; $client = new EQ12PhpOddsClient(); $client->getPlayerProps();\"",
        "stan": "C:/xampp/php/php.exe vendor/bin/phpstan analyse --level=5 .",
        "api-test": "C:/xampp/php/php.exe eq12_api.php",
        "bridge-test": "C:/xampp/php/php.exe eq12_python_bridge.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
