"""Rakuten cashback scraper - state machine style, dry-run-first, stealth-ready."""
import argparse
import json
import logging
import time
from typing import List, Dict, Any, Optional

logger = logging.getLogger("rakuten_scraper")
logging.basicConfig(level=logging.INFO)


class RakutenConfig:
    def __init__(self, dry_run: bool = True, out: str = "C:/EQ12/logs/rakuten.json"):
        self.dry_run = dry_run
        self.out = out


class RakutenState:
    def run(self, ctx: "RakutenScraper"):
        raise NotImplementedError()


class FetchDealsState(RakutenState):
    def run(self, ctx: "RakutenScraper"):
        logger.info("Fetching Rakuten deals (simulated)")
        # This is a placeholder for stealth Playwright scraping.
        # For now return a small static payload to exercise pipeline.
        deals = [
            {"merchant": "Example Store", "category": "Clothing", "cashback": 12, "link": "https://r.example/track"},
            {"merchant": "Another Shop", "category": "Electronics", "cashback": 3, "link": "https://r.example/track2"},
        ]
        ctx.deals = deals
        ctx.set_state(ProcessDealsState())


class ProcessDealsState(RakutenState):
    def run(self, ctx: "RakutenScraper"):
        logger.info("Processing %d deals", len(ctx.deals or []))
        if ctx.config.dry_run:
            logger.info("Dry-run: would write %d deals to %s", len(ctx.deals), ctx.config.out)
        else:
            with open(ctx.config.out, "w", encoding="utf-8") as fh:
                json.dump(ctx.deals, fh, indent=2)
            logger.info("Wrote deals to %s", ctx.config.out)
        ctx.set_state(FinishedState())


class FinishedState(RakutenState):
    def run(self, ctx: "RakutenScraper"):
        logger.info("Rakuten scraper finished")
        ctx.finished = True


class RakutenScraper:
    def __init__(self, config: RakutenConfig):
        self.config = config
        self.deals: List[Dict[str, Any]] = []
        self.state: RakutenState = FetchDealsState()
        self.finished = False

    def set_state(self, s: RakutenState):
        self.state = s

    def run(self):
        while not self.finished:
            self.state.run(self)


def build_parser():
    p = argparse.ArgumentParser()
    p.add_argument("--out", help="JSON output path", default="C:/EQ12/logs/rakuten.json")
    p.add_argument("--dry-run", dest="dry_run", action="store_true", help="Enable dry-run (default False)")
    p.add_argument("--no-dry-run", dest="dry_run", action="store_false", help="Disable dry-run")
    p.set_defaults(dry_run=True)
    return p


def main(argv: Optional[List[str]] = None) -> None:
    p = build_parser()
    args = p.parse_args(argv)
    cfg = RakutenConfig(dry_run=args.dry_run, out=args.out)
    scraper = RakutenScraper(cfg)
    scraper.run()


if __name__ == "__main__":
    main()
