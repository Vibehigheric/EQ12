# Main execution logic
try {
    Write-URLLog "EQ12 URL Scanner Manager started with action: $Action"

    $success = switch ($Action.ToLower()) {
        "start" {
            $result = Start-URLScanner
            if ($result) { Show-URLScannerInfo }
            $result
        }
        "stop" {
            Stop-URLScanner -Force:$Force
        }
        "restart" {
            if (Stop-URLScanner -Force:$Force) {
                Start-Sleep -Seconds 2
                $result = Start-URLScanner
                if ($result) { Show-URLScannerInfo }
                $result
            } else {
                $false
            }
        }
        "status" {
            Get-URLScannerStatus
            $true
        }
        "test" {
            if (!$TestUrl) {
                Write-URLLog "No test URL provided, using default..." "WARN"
            }
            Test-URLScanning
        }
        default {
            Write-URLLog "Invalid action: $Action. Use start, stop, restart, status, or test" "ERROR"
            $false
        }
    }

    if ($success) {
        Write-URLLog "URL scanner manager completed successfully"
        exit 0
    } else {
        Write-URLLog "URL scanner manager failed" "ERROR"
        exit 1
    }

} catch {
    Write-URLLog "Unexpected error in URL scanner manager: $_" "ERROR"
    exit 1
}
