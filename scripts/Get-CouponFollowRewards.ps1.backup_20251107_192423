[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
$ErrorActionPreference = "Stop"

<# EQ12 patch: PowerShell wrapper for CouponFollow Rewards scraper #>
[CmdletBinding()]
param(
    [switch]$DryRun,
    [string]$Watchlist = "configs/coupon_watchlist.json",
    [string]$OutPath = "C:\EQ12\logs\couponfollow_rewards.json"
)

function Get-CouponFollowRewards {
    [CmdletBinding()]
    param(
        [switch]$DryRun,
        [string]$Watchlist = "configs/coupon_watchlist.json",
        [string]$OutPath = "C:\EQ12\logs\couponfollow_rewards.json"
    )

    $py = Get-Command python -ErrorAction SilentlyContinue
    if (-not $py) { Write-Error "Python not found"; return }

    $pyArgs = @('scripts/cf_rewards_scraper.py')
    $pyArgs += '--watchlist'; $pyArgs += $Watchlist
    if ($DryRun) { $pyArgs += '--dry-run' } else { $pyArgs += '--no-dry-run' }
    $pyArgs += '--out'; $pyArgs += $OutPath

    Write-Host "Invoking cf_rewards_scraper with args: $($pyArgs -join ' ")"
    & $py.Source @pyArgs
}

if ($null -ne $PSCommandPath -and $MyInvocation.InvocationName -eq '.') {
    # dot-sourced
} elseif ($null -ne $MyInvocation.InvocationName) {
    Get-CouponFollowRewards -DryRun:$DryRun -Watchlist $Watchlist -OutPath $OutPath
}

