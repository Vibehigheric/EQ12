[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
$ErrorActionPreference = "Stop"

# EQ12 Enhanced Extension Installer
# Automated installation and setup script for all Firefox extension components

[CmdletBinding()]
param(
    [Parameter(Position = 0)]
    [ValidateSet('install', 'update', 'uninstall', 'test', 'package', 'help')]
    [string]$Action = 'install',

    [Parameter()]
    [switch]$DevMode,

    [Parameter()]
    [switch]$SkipDependencies,

    [Parameter()]
    [string]$FirefoxProfile = "",

    [Parameter()]
    [switch]$AutoStart
)

# Script configuration
$ExtensionPath = "C:\EQ12\firefox_extensions\eq12_betting_dashboard"
$LogFile = "C:\EQ12\logs\extension_installer_$(Get-Date -Format 'yyyyMMdd_HHmmss').log"
$RequiredFiles = @(
    'manifest.json',
    'background_v3_enhanced.js',
    'sportsbook_scraper_v3_enhanced.js',
    'popup_v3_enhanced.html',
    'popup_v3_enhanced.js',
    'options.html',
    'options.js',
    'privacy_manager.js',
    'developer_tools.js',
    'ui_enhancer.js',
    'proxy_manager.js',
    'tab_manager.js',
    'testing_dashboard.html'
)

function Write-Log {
    param([string]$Message, [string]$Level = "INFO")
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logEntry = "[$timestamp] [$Level] $Message"
    Write-Host $logEntry
    if (!(Test-Path (Split-Path $LogFile))) {
        New-Item -ItemType Directory -Path (Split-Path $LogFile) -Force | Out-Null
    }
    Add-Content -Path $LogFile -Value $logEntry
}

function Test-Prerequisites {
    Write-Log "Checking installation prerequisites..." "INFO"

    # Check Firefox installation
    $firefoxPaths = @(
        "${env:ProgramFiles}\Mozilla Firefox\firefox.exe",
        "${env:ProgramFiles(x86)}\Mozilla Firefox\firefox.exe"
    )

    $firefoxFound = $false
    foreach ($path in $firefoxPaths) {
        if (Test-Path $path) {
            Write-Log "Firefox found at: $path" "INFO"
            $firefoxFound = $true
            ${script}FirefoxPath = $path
            break
        }
    }

    if (!$firefoxFound) {
        Write-Log "Firefox not found. Please install Firefox first." "ERROR"
        Write-Log "Download from: https://www.mozilla.org/firefox/" "INFO"
        return $false
    }

    # Check extension directory
    if (!(Test-Path $ExtensionPath)) {
        Write-Log "Extension directory not found: $ExtensionPath" "ERROR"
        return $false
    }

    # Check required files
    $missingFiles = @()
    foreach ($file in $RequiredFiles) {
        $filePath = Join-Path $ExtensionPath $file
        if (!(Test-Path $filePath)) {
            $missingFiles += $file
        }
    }

    if ($missingFiles.Count -gt 0) {
        Write-Log "Missing required files: $($missingFiles -join ', ')" "ERROR"
        return $false
    }

    # Check Python installation (for enhanced features)
    if (!$SkipDependencies) {
        try {
            $pythonVersion = python --version 2>&1
            Write-Log "Python found: $pythonVersion" "INFO"
        } catch {
            Write-Log "Python not found. Some features may not work." "WARN"
        }

        # Check Node.js (for development features)
        try {
            $nodeVersion = node --version 2>&1
            Write-Log "Node.js found: $nodeVersion" "INFO"
        } catch {
            Write-Log "Node.js not found. Developer features limited." "WARN"
        }
    }

    Write-Log "Prerequisites check completed" "INFO"
    return $true
}

function Install-Dependencies {
    if ($SkipDependencies) {
        Write-Log "Skipping dependency installation" "INFO"
        return
    }

    Write-Log "Installing extension dependencies..." "INFO"

    # Install Python packages for backend integration
    try {
        $pythonPackages = @('requests', 'selenium', 'sqlite3', 'fastapi', 'uvicorn')
        foreach ($package in $pythonPackages) {
            Write-Log "Installing Python package: $package" "INFO"
            pip install $package --quiet
        }
    } catch {
        Write-Log "Failed to install Python packages: $($_.Exception.Message)" "WARN"
    }

    # Create necessary directories
    $directories = @(
        'C:\EQ12\logs',
        'C:\EQ12\firefox_extensions\eq12_betting_dashboard\icons',
        'C:\EQ12\firefox_extensions\eq12_betting_dashboard\assets'
    )

    foreach ($dir in $directories) {
        if (!(Test-Path $dir)) {
            New-Item -ItemType Directory -Path $dir -Force | Out-Null
            Write-Log "Created directory: $dir" "INFO"
        }
    }
}

function New-ExtensionIcons {
    Write-Log "Creating extension icons..." "INFO"

    $iconPath = Join-Path $ExtensionPath "icons"
    if (!(Test-Path $iconPath)) {
        New-Item -ItemType Directory -Path $iconPath -Force | Out-Null
    }

    # Create simple icons (in a real scenario, these would be proper PNG files)
    $iconSizes = @(16, 32, 48, 128)
    foreach ($size in $iconSizes) {
        $iconFile = Join-Path $iconPath "eq12-$size.png"
        if (!(Test-Path $iconFile)) {
            # Create a placeholder file (would be a real PNG in production)
            "EQ12 Icon $size x $size" | Out-File -FilePath $iconFile -Encoding utf8
            Write-Log "Created icon placeholder: eq12-$size.png" "INFO"
        }
    }
}

function Test-ExtensionStructure {
    Write-Log "Validating extension structure..." "INFO"

    # Validate manifest.json
    try {
        $manifestPath = Join-Path $ExtensionPath "manifest.json"
        $manifest = Get-Content $manifestPath -Raw | ConvertFrom-Json

        # Check required manifest fields
        $requiredFields = @('manifest_version', 'name', 'version', 'description', 'permissions')
        foreach ($field in $requiredFields) {
            if (!$manifest.$field) {
                Write-Log "Missing required manifest field: $field" "ERROR"
                return $false
            }
        }

        Write-Log "Manifest validation passed" "INFO"
        Write-Log "Extension: $($manifest.name) v$($manifest.version)" "INFO"
        Write-Log "Manifest Version: $($manifest.manifest_version)" "INFO"

    } catch {
        Write-Log "Manifest validation failed: $($_.Exception.Message)" "ERROR"
        return $false
    }

    # Check file sizes (detect potential issues)
    foreach ($file in $RequiredFiles) {
        $filePath = Join-Path $ExtensionPath $file
        $fileSize = (Get-Item $filePath).Length

        if ($fileSize -eq 0) {
            Write-Log "Warning: $file is empty" "WARN"
        } elseif ($fileSize -gt 1MB) {
            Write-Log "Warning: $file is large (${fileSize} bytes)" "WARN"
        } else {
            Write-Log "$file validated (${fileSize} bytes)" "INFO"
        }
    }

    return $true
}

function Install-ExtensionInFirefox {
    Write-Log "Installing extension in Firefox..." "INFO"

    # Create or use existing Firefox profile for testing
    $profileName = if ($FirefoxProfile) { $FirefoxProfile } else { "EQ12_Extension_Test" }
    $profilePath = Join-Path ${env}APPDATA "Mozilla\Firefox\Profiles\$profileName"

    if (!(Test-Path $profilePath)) {
        Write-Log "Creating Firefox profile: $profileName" "INFO"
        & ${script}FirefoxPath -CreateProfile "$profileName $profilePath" -headless
        Start-Sleep -Seconds 2
    }

    # Configure profile for extension development
    $prefsFile = Join-Path $profilePath "prefs.js"
    $devPrefs = @(
        'user_pref("xpinstall.signatures.required", false);',
        'user_pref("extensions.ui.developer.hidden", false);',
        'user_pref("devtools.chrome.enabled", true);',
        'user_pref("devtools.debugger.remote-enabled", true);',
        'user_pref("extensions.autoDisableScopes", 0);'
    )

    foreach ($pref in $devPrefs) {
        Add-Content -Path $prefsFile -Value $pref
    }

    Write-Log "Firefox profile configured for extension development" "INFO"

    if ($AutoStart) {
        # Launch Firefox with the extension
        Write-Log "Starting Firefox with extension..." "INFO"
        Start-Process -FilePath ${script}FirefoxPath -ArgumentList @(
            "-profile", $profilePath,
            "about:debugging#/runtime/this-firefox"
        ) -WindowStyle Normal

        Write-Log "Firefox started. Please manually load the extension:" "INFO"
        Write-Log "1. Click 'Load Temporary Add-on'" "INFO"
        Write-Log "2. Navigate to: $ExtensionPath" "INFO"
        Write-Log "3. Select: manifest.json" "INFO"
    } else {
        Write-Log "Extension ready for manual installation" "INFO"
        Write-Log "To install: Open Firefox -> about:debugging -> Load Temporary Add-on -> Select manifest.json" "INFO"
    }
}

function New-ExtensionPackage {
    Write-Log "Creating extension package..." "INFO"

    $packageName = "eq12_extension_enhanced_$(Get-Date -Format 'yyyyMMdd_HHmmss')"
    $packagePath = "C:\EQ12\$packageName.zip"

    # Exclude development files from package
    $excludePatterns = @(
        '*.log',
        '*.tmp',
        '*~',
        '.git*',
        'node_modules',
        'test_*'
    )

    try {
        # Create temporary directory for packaging
        $tempDir = Join-Path ${env}TEMP $packageName
        if (Test-Path $tempDir) {
            Remove-Item $tempDir -Recurse -Force
        }
        New-Item -ItemType Directory -Path $tempDir -Force | Out-Null

        # Copy extension files
        $files = Get-ChildItem $ExtensionPath -File -Recurse | Where-Object {
            $exclude = $false
            foreach ($pattern in $excludePatterns) {
                if ($_.Name -like $pattern) {
                    $exclude = $true
                    break
                }
            }
            return !$exclude
        }

        foreach ($file in $files) {
            $relativePath = $file.FullName.Substring($ExtensionPath.Length + 1)
            $destPath = Join-Path $tempDir $relativePath
            $destDir = Split-Path $destPath

            if (!(Test-Path $destDir)) {
                New-Item -ItemType Directory -Path $destDir -Force | Out-Null
            }

            Copy-Item $file.FullName $destPath
        }

        # Create zip package
        Compress-Archive -Path "$tempDir\*" -DestinationPath $packagePath -Force

        # Cleanup
        Remove-Item $tempDir -Recurse -Force

        $packageSize = (Get-Item $packagePath).Length
        Write-Log "Extension package created: $packagePath (${packageSize} bytes)" "INFO"

        return $packagePath
    } catch {
        Write-Log "Package creation failed: $($_.Exception.Message)" "ERROR"
        return $null
    }
}

function Test-ExtensionFunctionality {
    Write-Log "Running extension functionality tests..." "INFO"

    # Test manifest validation
    if (!(Test-ExtensionStructure)) {
        return $false
    }

    # Test file permissions
    foreach ($file in $RequiredFiles) {
        $filePath = Join-Path $ExtensionPath $file
        try {
            $content = Get-Content $filePath -Raw
            if ($file.EndsWith('.js')) {
                # Basic JavaScript syntax check
                if ($content -match 'syntax error|SyntaxError') {
                    Write-Log "Potential syntax error in $file" "WARN"
                }
            } elseif ($file.EndsWith('.json')) {
                # JSON validation
                $json = $content | ConvertFrom-Json
                Write-Log "$file JSON structure validated" "INFO"
            }
        } catch {
            Write-Log "Failed to validate ${file} $($_.Exception.Message)" "ERROR"
            return $false
        }
    }

    # Test backend connectivity (if available)
    try {
        $response = Invoke-WebRequest -Uri "http://localhost:8000/api/health" -Method GET -TimeoutSec 5 -ErrorAction Stop
        Write-Log "Backend connectivity verified" "INFO"
    } catch {
        Write-Log "Backend not available (this is optional)" "WARN"
    }

    Write-Log "Extension functionality tests completed" "INFO"
    return $true
}

function Uninstall-Extension {
    Write-Log "Uninstalling EQ12 extension components..." "INFO"

    # Note: Extension must be manually removed from Firefox
    Write-Log "Please manually remove the extension from Firefox:" "INFO"
    Write-Log "1. Open Firefox" "INFO"
    Write-Log "2. Go to about:addons" "INFO"
    Write-Log "3. Find 'EQ12 Betting Dashboard Companion'" "INFO"
    Write-Log "4. Click 'Remove'" "INFO"

    # Clean up logs and temporary files
    $cleanupPaths = @(
        "C:\EQ12\logs\extension_*",
        "C:\EQ12\*_extension_*.zip"
    )

    foreach ($path in $cleanupPaths) {
        Get-ChildItem $path -ErrorAction SilentlyContinue | Remove-Item -Force
        Write-Log "Cleaned up: $path" "INFO"
    }

    Write-Log "Extension uninstall completed" "INFO"
}

function Show-Help {
    Write-Host @"
EQ12 Enhanced Extension Installer

USAGE:
    .\eq12_extension_installer.ps1 [ACTION] [OPTIONS]

ACTIONS:
    install     Install and configure the extension (default)
    update      Update existing installation
    uninstall   Remove extension and cleanup
    test        Run functionality tests
    package     Create distributable package
    help        Show this help message

OPTIONS:
    -DevMode               Enable developer mode features
    -SkipDependencies      Skip Python/Node.js dependency installation
    -FirefoxProfile <name> Use specific Firefox profile (creates if needed)
    -AutoStart             Automatically start Firefox after installation

EXAMPLES:
    # Standard installation
    .\eq12_extension_installer.ps1 install

    # Developer installation with auto-start
    .\eq12_extension_installer.ps1 install -DevMode -AutoStart

    # Create distribution package
    .\eq12_extension_installer.ps1 package

    # Run tests only
    .\eq12_extension_installer.ps1 test

ENHANCED FEATURES INCLUDED:
    ✓ Privacy Protection (Ghostery/Privacy Badger inspired)
      - Tracker blocking, fingerprinting protection
      - DNS leak prevention, WebRTC protection
      - Advanced user agent spoofing

    ✓ Developer Tools (Mobile DevTools/Clear Cache inspired)
      - Remote debugging console
      - Performance monitoring
      - Element measurement tools
      - Advanced cache management

    ✓ UI Enhancements (Stylus/Dark Reader inspired)
      - Smart dark mode with image adjustments
      - Auto-reload for live odds updates
      - Custom CSS injection system
      - Accessibility improvements

    ✓ Proxy & VPN Integration (FoxyProxy inspired)
      - Multi-proxy management
      - VPN leak detection and protection
      - Network rule automation
      - Connection health monitoring

    ✓ Advanced Tab Management
      - Multi-sportsbook coordination
      - Session analytics
      - Tab grouping and batch operations
      - Real-time monitoring

REQUIREMENTS:
    - Firefox (latest version recommended)
    - Windows 10/11
    - Python 3.7+ (optional, for enhanced features)
    - Node.js (optional, for development features)

FILES INSTALLED:
    Enhanced Modules:
    - privacy_manager.js (Security & Privacy)
    - developer_tools.js (Debugging & Development)
    - ui_enhancer.js (Interface & Automation)
    - proxy_manager.js (VPN & Proxy Management)
    - tab_manager.js (Advanced Tab Control)

    Core Files:
    - manifest.json (Extension Configuration)
