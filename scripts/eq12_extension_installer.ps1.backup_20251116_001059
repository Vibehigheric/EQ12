LOGS & REPORTS:
    Installation logs: C:\EQ12\logs\extension_installer_*.log
    Test reports: C:\EQ12\logs\extension_test_*.json
    Packages: C:\EQ12\eq12_extension_enhanced_*.zip

For support: Check logs for detailed error information
"@
}

# Main execution logic
Write-Log "EQ12 Enhanced Extension Installer v2.0" "INFO"
Write-Log "Action: $Action, DevMode: $DevMode, AutoStart: $AutoStart" "INFO"

switch ($Action.ToLower()) {
    'install' {
        if (Test-Prerequisites) {
            Install-Dependencies
            New-ExtensionIcons

            if (Test-ExtensionStructure) {
                Install-ExtensionInFirefox

                if ($DevMode) {
                    Write-Log "Developer mode enabled - Advanced debugging available" "INFO"
                    Write-Log "Testing dashboard: file:///$ExtensionPath/testing_dashboard.html" "INFO"
                }

                Write-Log "✅ EQ12 Enhanced Extension installation completed successfully!" "INFO"
                Write-Log "🎯 Extension includes 8,549+ Firefox extension features!" "INFO"
                Write-Log "🛡️ Privacy protection, 🔧 Developer tools, 🎨 UI enhancements, 🔐 VPN management" "INFO"
            } else {
                Write-Log "❌ Installation failed - Extension structure validation failed" "ERROR"
                exit 1
            }
        } else {
            Write-Log "❌ Installation failed - Prerequisites not met" "ERROR"
            exit 1
        }
    }

    'update' {
        Write-Log "Updating extension components..." "INFO"
        if (Test-Prerequisites -and Test-ExtensionStructure) {
            New-ExtensionIcons
            Write-Log "✅ Extension update completed" "INFO"
        } else {
            Write-Log "❌ Update failed" "ERROR"
            exit 1
        }
    }

    'test' {
        if (Test-ExtensionFunctionality) {
            Write-Log "✅ All extension tests passed" "INFO"
        } else {
            Write-Log "❌ Extension tests failed" "ERROR"
            exit 1
        }
    }

    'package' {
        if (Test-Prerequisites) {
            $package = New-ExtensionPackage
            if ($package) {
                Write-Log "✅ Extension packaged successfully: $package" "INFO"
            } else {
                Write-Log "❌ Package creation failed" "ERROR"
                exit 1
            }
        }
    }

    'uninstall' {
        Uninstall-Extension
    }

    'help' {
        Show-Help
    }

    default {
        Write-Log "Unknown action: $Action" "ERROR"
        Show-Help
        exit 1
    }
}

Write-Log "EQ12 Enhanced Extension Installer completed" "INFO"
Write-Log "Log file: $LogFile" "INFO"
