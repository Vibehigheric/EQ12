[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
$ErrorActionPreference = "Stop"

#Requires -Version 5.1

<#
.SYNOPSIS
🌐 EQ12 Browser Extension Deployment Wrapper

.DESCRIPTION
PowerShell wrapper for automated browser extension creation, packaging, and submission guidance.
Comprehensive toolkit for creating monetized security monitoring browser extensions.

.PARAMETER Action
The action to perform: CreateExtension, Package, FullBuild, SubmissionGuide

.PARAMETER ExtensionName
Name of the browser extension to create

.PARAMETER Workspace
EQ12 workspace path

.PARAMETER VerboseOutput
Enable verbose output for detailed logging

.PARAMETER GenerateReport
Generate comprehensive deployment report

.EXAMPLE
.\eq12_browser_extension_wrapper.ps1 -Action FullBuild -VerboseOutput

.EXAMPLE
.\eq12_browser_extension_wrapper.ps1 -Action CreateExtension -ExtensionName "EQ12SecureWeb"

.NOTES
Created: November 7, 2025
Author: EQ12 Product Development Team
Purpose: Browser extension development and monetization automation
Classification: PRODUCT DEVELOPMENT - REVENUE GENERATION
#>

[CmdletBinding()]
param(
    [Parameter(Mandatory = $false)]
    [ValidateSet("CreateExtension", "Package", "FullBuild", "SubmissionGuide")]
    [string]$Action = "FullBuild",
    
    [Parameter(Mandatory = $false)]
    [string]$ExtensionName = "EQ12SecurityMonitor",
    
    [Parameter(Mandatory = $false)]
    [string]$Workspace = "C:\EQ12",
    
    [Parameter(Mandatory = $false)]
    [switch]$VerboseOutput,
    
    [Parameter(Mandatory = $false)]
    [switch]$GenerateReport
)

# Initialize logging
$timestamp = Get-Date -Format "yyyyMMdd_HHmmss"
$logPath = Join-Path $Workspace "logs" "browser_extension_deployment_$timestamp.log"
$reportPath = Join-Path $Workspace "logs" "browser_extension_report_$timestamp.json"

function Write-LogMessage {
    param(
        [string]$Message,
        [string]$Level = "INFO"
    )
    
    $timestampLog = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $logEntry = "[$timestampLog] [$Level] $Message"
    
    # Console output with colors
    switch ($Level) {
        "ERROR" { Write-Host $logEntry -ForegroundColor Red }
        "WARNING" { Write-Host $logEntry -ForegroundColor Yellow }
        "SUCCESS" { Write-Host $logEntry -ForegroundColor Green }
        "INFO" { Write-Host $logEntry -ForegroundColor Cyan }
        default { Write-Host $logEntry }
    }
    
    # File logging
    $logEntry | Out-File -FilePath $logPath -Append -Encoding UTF8
}

function Test-PythonEnvironment {
    Write-LogMessage "🐍 Testing Python environment..."
    
    try {
        $pythonVersion = python --version 2>&1
        if ($LASTEXITCODE -eq 0) {
            Write-LogMessage "✅ Python available: $pythonVersion" "SUCCESS"
            return $true
        } else {
            Write-LogMessage "❌ Python not found in PATH" "ERROR"
            return $false
        }
    } catch {
        Write-LogMessage "❌ Error testing Python: $($_.Exception.Message)" "ERROR"
        return $false
    }
}

function Invoke-BrowserExtensionBuilder {
    param(
        [string]$BuildAction,
        [string]$ExtName,
        [string]$WorkspacePath,
        [bool]$Verbose
    )
    
    Write-LogMessage "🌐 Invoking browser extension builder..."
    
    $scriptPath = Join-Path $WorkspacePath "scripts" "eq12_browser_extension_builder.py"
    
    if (-not (Test-Path $scriptPath)) {
        Write-LogMessage "❌ Extension builder script not found: $scriptPath" "ERROR"
        return $null
    }
    
    $arguments = @(
        $scriptPath,
        "--action", $BuildAction.ToLower(),
        "--workspace", $WorkspacePath,
        "--extension-name", $ExtName
    )
    
    if ($Verbose) {
        $arguments += "--verbose"
    }
    
    try {
        Write-LogMessage "🚀 Executing: python $($arguments -join ' ')"
        
        $result = python @arguments 2>&1
        $exitCode = $LASTEXITCODE
        
        if ($exitCode -eq 0) {
            Write-LogMessage "✅ Browser extension builder completed successfully" "SUCCESS"
            Write-LogMessage "📋 Output: $result" "INFO"
            return @{
                Success = $true
                Output = $result
                ExitCode = $exitCode
            }
        } else {
            Write-LogMessage "❌ Browser extension builder failed with exit code: $exitCode" "ERROR"
            Write-LogMessage "📋 Error output: $result" "ERROR"
            return @{
                Success = $false
                Output = $result
                ExitCode = $exitCode
            }
        }
    } catch {
        Write-LogMessage "❌ Exception executing browser extension builder: $($_.Exception.Message)" "ERROR"
        return @{
            Success = $false
            Output = $_.Exception.Message
            ExitCode = -1
        }
    }
}

function Get-ExtensionBuildStatus {
    param([string]$WorkspacePath)
    
    $extensionsPath = Join-Path $WorkspacePath "browser_extensions"
    $status = @{
        ExtensionsDirectoryExists = Test-Path $extensionsPath
        ExtensionDirectories = @()
        PackageFiles = @()
        SubmissionGuides = @()
    }
    
    if ($status.ExtensionsDirectoryExists) {
        $status.ExtensionDirectories = Get-ChildItem -Path $extensionsPath -Directory | Select-Object -ExpandProperty Name
        $status.PackageFiles = Get-ChildItem -Path $extensionsPath -Filter "*.zip" | Select-Object -ExpandProperty Name
        $status.SubmissionGuides = Get-ChildItem -Path $extensionsPath -Filter "submission_guide_*.md" | Select-Object -ExpandProperty Name
    }
    
    return $status
}

