function New-DeploymentReport {
    param(
        [hashtable]$BuildResult,
        [hashtable]$BuildStatus,
        [string]$WorkspacePath
    )
    
    $report = @{
        timestamp = (Get-Date -Format "yyyy-MM-dd HH:mm:ss")
        action = $Action
        extensionName = $ExtensionName
        workspace = $WorkspacePath
        buildResult = $BuildResult
        buildStatus = $BuildStatus
        metrics = @{
            totalPackages = $BuildStatus.PackageFiles.Count
            submissionGuides = $BuildStatus.SubmissionGuides.Count
            extensionDirectories = $BuildStatus.ExtensionDirectories.Count
        }
        nextSteps = @(
            "Test extensions in browser development modes",
            "Verify all security monitoring features",
            "Submit to Firefox Add-ons (free)",
            "Submit to Edge Add-ons (free)",
            "Submit to Chrome Web Store ($5 fee)",
            "Implement premium monetization features",
            "Launch marketing campaigns"
        )
        monetization = @{
            revenuePotential = 29940
            targetUsers = 10000
            premiumConversion = "5%"
            monthlyPrice = 4.99
            submissionCosts = @{
                firefox = "FREE"
                edge = "FREE"
                chrome = "$5 (one-time)"
            }
        }
    }
    
    $reportJson = $report | ConvertTo-Json -Depth 10
    $reportJson | Out-File -FilePath $reportPath -Encoding UTF8
    
    Write-LogMessage "📊 Deployment report generated: $reportPath" "SUCCESS"
    return $report
}

# Main execution
try {
    Write-LogMessage "🌐 Starting EQ12 Browser Extension Deployment" "INFO"
    Write-LogMessage "📋 Action: $Action | Extension: $ExtensionName | Workspace: $Workspace"
    
    # Test Python environment
    if (-not (Test-PythonEnvironment)) {
        Write-LogMessage "❌ Python environment test failed. Cannot proceed." "ERROR"
        exit 1
    }
    
    # Execute browser extension builder
    $buildResult = Invoke-BrowserExtensionBuilder -BuildAction $Action -ExtName $ExtensionName -WorkspacePath $Workspace -Verbose $VerboseOutput.IsPresent
    
    if (-not $buildResult.Success) {
        Write-LogMessage "❌ Browser extension builder failed" "ERROR"
        exit 1
    }
    
    # Get build status
    $buildStatus = Get-ExtensionBuildStatus -WorkspacePath $Workspace
    
    # Create additional resources
    if ($Action -eq "FullBuild") {
        Write-LogMessage "📋 Creating submission checklist..." "INFO"
        $checklistPath = New-SubmissionCheckList -WorkspacePath $Workspace -PackageFiles $buildStatus.PackageFiles
        
        Write-LogMessage "💰 Creating monetization strategy..." "INFO"
        $strategyPath = New-MonetizationStrategy -WorkspacePath $Workspace
        
        Write-LogMessage "✅ Additional resources created:" "SUCCESS"
        Write-LogMessage "   📋 Checklist: $checklistPath" "INFO"
        Write-LogMessage "   💰 Strategy: $strategyPath" "INFO"
    }
    
    # Generate deployment report
    if ($GenerateReport) {
        $report = New-DeploymentReport -BuildResult $buildResult -BuildStatus $buildStatus -WorkspacePath $Workspace
        Write-LogMessage "📊 Deployment report generated" "SUCCESS"
    }
    
    # Summary output
    Write-LogMessage "🚀 BROWSER EXTENSION DEPLOYMENT COMPLETE" "SUCCESS"
    Write-LogMessage "   📁 Extensions Directory: $(Join-Path $Workspace 'browser_extensions')" "INFO"
    Write-LogMessage "   📦 Packages Created: $($buildStatus.PackageFiles.Count)" "SUCCESS"
    Write-LogMessage "   📋 Submission Guides: $($buildStatus.SubmissionGuides.Count)" "SUCCESS"
    
    Write-LogMessage "💰 MONETIZATION SUMMARY" "SUCCESS"
    Write-LogMessage "   💵 Revenue Potential: $29,940/year" "INFO"
    Write-LogMessage "   🎯 Target Users: 10,000" "INFO"
    Write-LogMessage "   💳 Premium Price: $4.99/month" "INFO"
    Write-LogMessage "   📊 Conversion Target: 5%" "INFO"
    
    Write-LogMessage "📊 SUBMISSION COSTS" "SUCCESS"
    Write-LogMessage "   🆓 Firefox Add-ons: FREE" "INFO"
    Write-LogMessage "   🆓 Edge Add-ons: FREE" "INFO"
    Write-LogMessage "   💳 Chrome Web Store: $5 (one-time)" "INFO"
    
    Write-LogMessage "✅ Browser extension deployment completed successfully" "SUCCESS"
    
} catch {
    Write-LogMessage "❌ Critical error in browser extension deployment: $($_.Exception.Message)" "ERROR"
    Write-LogMessage "📋 Stack trace: $($_.ScriptStackTrace)" "ERROR"
    exit 1
}