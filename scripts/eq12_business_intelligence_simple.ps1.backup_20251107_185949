# EQ12 COMPLETE BUSINESS INTELLIGENCE SYSTEM
param(
    [string]$Action = "Full",
    [string]$Workspace = "C:\EQ12"
)

Write-Host "================================================================================" -ForegroundColor Green
Write-Host "EQ12 COMPLETE BUSINESS INTELLIGENCE SYSTEM" -ForegroundColor Green
Write-Host "Advanced Revenue Tracking | Business Strategy | Marketing Analytics" -ForegroundColor Green
Write-Host "================================================================================" -ForegroundColor Green

# Check workspace
if (-not (Test-Path $Workspace)) {
    Write-Host "ERROR: Workspace not found: $Workspace" -ForegroundColor Red
    exit 1
}

# Create necessary directories
$dirs = @("logs", "reports", "dashboard", "data")
foreach ($dir in $dirs) {
    $dirPath = Join-Path $Workspace $dir
    if (-not (Test-Path $dirPath)) {
        New-Item -ItemType Directory -Path $dirPath -Force | Out-Null
    }
}

Write-Host "EXECUTING COMPLETE BUSINESS INTELLIGENCE SYSTEM..." -ForegroundColor Yellow

# 1. Run Business Intelligence Tracker
Write-Host "1. Running Business Intelligence Tracker..." -ForegroundColor Cyan
$trackerScript = Join-Path $Workspace "scripts\eq12_business_intelligence_tracker.py"
if (Test-Path $trackerScript) {
    python $trackerScript --workspace $Workspace --action full
    Write-Host "   Business Intelligence Analysis Complete" -ForegroundColor Green
} else {
    Write-Host "   Business Intelligence Tracker not found" -ForegroundColor Red
}

Write-Host ""

# 2. Run Advanced Revenue Reporter
Write-Host "2. Running Advanced Revenue Reporter..." -ForegroundColor Cyan
$reporterScript = Join-Path $Workspace "scripts\eq12_advanced_revenue_reporter.py"
if (Test-Path $reporterScript) {
    python $reporterScript --workspace $Workspace --action publish --publish dashboard
    Write-Host "   Revenue Reports Generated and Published" -ForegroundColor Green
} else {
    Write-Host "   Advanced Revenue Reporter not found" -ForegroundColor Red
}

Write-Host ""
Write-Host "================================================================================" -ForegroundColor Green
Write-Host "BUSINESS INTELLIGENCE SYSTEM - COMPLETE STATUS REPORT" -ForegroundColor Green
Write-Host "================================================================================" -ForegroundColor Green

# Display comprehensive results
