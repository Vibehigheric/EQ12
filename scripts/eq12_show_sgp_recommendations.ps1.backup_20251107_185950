#Requires -Version 5.1
[CmdletBinding()]
param(
    [string]$ReportsPath = "C:\EQ12\coral_betting_ai\reports",
    [int]$TopN = 5
)

$ErrorActionPreference = "Stop"

Write-Host "🏀 EQ12 TONIGHT'S NBA SGP RECOMMENDATIONS" -ForegroundColor Green
Write-Host "=" * 50 -ForegroundColor Yellow

# Find the latest SGP analysis file
$latestFile = Get-ChildItem "$ReportsPath\draftkings_sgp_analysis_*.json" | 
              Sort-Object LastWriteTime -Descending | 
              Select-Object -First 1

if (-not $latestFile) {
    Write-Host "❌ No SGP analysis files found in $ReportsPath" -ForegroundColor Red
    exit 1
}

Write-Host "📊 Analysis: $($latestFile.Name)" -ForegroundColor Cyan
Write-Host "🕒 Generated: $($latestFile.LastWriteTime)" -ForegroundColor Gray

try {
    $analysis = Get-Content $latestFile.FullName | ConvertFrom-Json
    
    Write-Host "`n📈 ANALYSIS SUMMARY:" -ForegroundColor Yellow
    Write-Host "   Games Analyzed: $($analysis.total_games_analyzed)" -ForegroundColor White
    Write-Host "   Best Game: $($analysis.analysis_summary.best_game)" -ForegroundColor White
    Write-Host "   Total EV: +$($analysis.total_potential_ev)" -ForegroundColor Green
    Write-Host "   Recommended Stakes: `$$($analysis.analysis_summary.total_recommended_stake)" -ForegroundColor White
    Write-Host "   Average Confidence: $([math]::Round($analysis.analysis_summary.avg_confidence * 100, 1))%" -ForegroundColor White
    
    Write-Host "`n🏆 TOP $TopN SGP RECOMMENDATIONS:" -ForegroundColor Yellow
    
    $sortedSgps = $analysis.recommended_sgps.PSObject.Properties | 
                  Sort-Object { $_.Value.total_ev } -Descending |
                  Select-Object -First $TopN
    
    $rank = 1
    foreach ($sgp in $sortedSgps) {
        $game = $sgp.Name
        $data = $sgp.Value
        
        Write-Host "`n#${rank}: $game" -ForegroundColor Cyan
        Write-Host "    💰 Payout Odds: $($data.estimated_payout_odds)" -ForegroundColor Green
        Write-Host "    🎯 Confidence: $([math]::Round($data.overall_confidence * 100, 1))%" -ForegroundColor White
        Write-Host "    📊 EV Score: +$($data.total_ev)" -ForegroundColor Green
        Write-Host "    💵 Stake: `$$($data.recommended_stake)" -ForegroundColor White
        Write-Host "    🏆 Potential Win: `$$([math]::Round($data.potential_payout, 2))" -ForegroundColor Yellow
        Write-Host "    ⚠️  Risk: $($data.risk_assessment)" -ForegroundColor White
        Write-Host "    🧬 Coral Grade: $($data.coral_ai_grade)" -ForegroundColor Magenta
        
        Write-Host "    📝 Top 3 Legs:" -ForegroundColor Gray
        $topLegs = $data.legs | Sort-Object ev -Descending | Select-Object -First 3
        foreach ($leg in $topLegs) {
            $oddsDisplay = if ($leg.odds -gt 0) { "+$([math]::Round($leg.odds))" } else { "$([math]::Round($leg.odds))" }
            Write-Host "       - $($leg.selection) ($oddsDisplay)" -ForegroundColor White
        }
        
        $rank++
    }
    
    Write-Host "`n🎯 BETTING STRATEGY NOTES:" -ForegroundColor Yellow
    Write-Host "   - Start with the highest EV games (SAC @ DEN recommended)" -ForegroundColor White
    Write-Host "   - Consider splitting stakes across top 2-3 SGPs for diversification" -ForegroundColor White
    Write-Host "   - All recommendations include player props for optimal correlation" -ForegroundColor White
    Write-Host "   - Coral AI grades A- or higher have strongest analytical backing" -ForegroundColor White
    
    Write-Host "`n📱 Full analysis file: $($latestFile.FullName)" -ForegroundColor Gray
    Write-Host "🚀 Generated by EQ12 Coral Edge TPU Sports Betting AI" -ForegroundColor Green
}
catch {
    Write-Host "❌ Error reading analysis file: $($_.Exception.Message)" -ForegroundColor Red
    exit 1
}