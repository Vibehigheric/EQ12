###############################################################################
# 7) Deterministic Tests - Same seed for reproducibility
###############################################################################

# @name deterministic_run_1
POST {{baseUrl}}/responses
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "model": "{{model}}",
  "temperature": 0.0,
  "seed": 12345,
  "reasoning": {
    "effort": "low"
  },
  "prompt": {
    "id": "pmpt_eq12_build_parlay_v1",
    "version": "current",
    "variables": {
      "allowed_books": "DraftKings,FanDuel,BetMGM",
      "max_legs": "4",
      "corr": "0.08",
      "min_ev": "0.08",
      "bankroll": "1000",
      "legs_json": "[{\"book\":\"DraftKings\",\"game_id\":\"nfl_20251005_chiefs_bills\",\"market\":\"spread\",\"selection\":\"Kansas City Chiefs -3.5\",\"odds\":-110,\"point\":-3.5,\"model_prob\":0.55,\"ev\":0.089,\"hook_flag\":true},{\"book\":\"FanDuel\",\"game_id\":\"nfl_20251005_packers_bears\",\"market\":\"spread\",\"selection\":\"Green Bay Packers -6.5\",\"odds\":-108,\"point\":-6.5,\"model_prob\":0.58,\"ev\":0.092,\"hook_flag\":true}]"
    }
  }
}

