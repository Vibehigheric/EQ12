###############################################################################
# 8) Quick Test Datasets for Exercise
###############################################################################

# Hooks Pack - All half-point spreads/totals
# @name test_hooks_pack
POST {{baseUrl}}/responses
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "model": "{{model}}",
  "temperature": {{temperature}},
  "prompt": {
    "id": "pmpt_eq12_spread_hooks_v1", 
    "version": "current",
    "variables": {
      "allowed_books": "DraftKings,FanDuel,BetMGM",
      "max_legs": "6",
      "corr": "0.08",
      "min_ev": "0.08", 
      "bankroll": "1000",
      "legs_json": "[{\"book\":\"DraftKings\",\"market\":\"spread\",\"selection\":\"Team A -2.5\",\"odds\":-110,\"point\":-2.5,\"hook_flag\":true,\"ev\":0.089},{\"book\":\"FanDuel\",\"market\":\"spread\",\"selection\":\"Team B +3.5\",\"odds\":-105,\"point\":3.5,\"hook_flag\":true,\"ev\":0.092},{\"book\":\"BetMGM\",\"market\":\"total\",\"selection\":\"Over 47.5\",\"odds\":102,\"point\":47.5,\"hook_flag\":true,\"ev\":0.076}]"
    }
  }
}

# Edge EV Pack - Mix of moderate and high EV
# @name test_edge_ev_pack  
POST {{baseUrl}}/responses
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "model": "{{model}}",
  "temperature": {{temperature}},
  "prompt": {
    "id": "pmpt_eq12_build_parlay_v1",
    "version": "current",
    "variables": {
      "allowed_books": "DraftKings,FanDuel,BetMGM",
      "max_legs": "8",
      "corr": "0.08",
      "min_ev": "0.07",
      "bankroll": "1000", 
      "legs_json": "[{\"book\":\"DraftKings\",\"market\":\"spread\",\"selection\":\"Team A -1.5\",\"odds\":105,\"ev\":0.121},{\"book\":\"FanDuel\",\"market\":\"moneyline\",\"selection\":\"Team B\",\"odds\":145,\"ev\":0.076},{\"book\":\"BetMGM\",\"market\":\"total\",\"selection\":\"Under 44.5\",\"odds\":108,\"ev\":0.089}]"
    }
  }
}

###############################################################################
# Instructions for Use:
#
# 1. Install "REST Client" extension in VS Code
# 2. Set OPENAI_API_KEY environment variable
# 3. Click "Send Request" above any ### request
# 4. Compare results across different scenarios
# 5. Use seed for reproducible testing
# 6. Adjust temperature (0.0-1.0) and reasoning effort (low/medium/high)
#
# Pro Tips:
# - Use Ctrl+Alt+R to run requests quickly
# - Save responses as .json files for comparison
# - Test constraint enforcement with adversarial examples
# - Validate hooks specialist only selects half-point spreads/totals
###############################################################################