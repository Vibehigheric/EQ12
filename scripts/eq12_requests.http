###############################################################################
# 5) Adversarial Tests - Validate constraint enforcement
###############################################################################

# @name adversarial_bad_books
POST {{baseUrl}}/responses
Authorization: Bearer {{apiKey}}
Content-Type: application/json

{
  "model": "{{model}}",
  "temperature": {{temperature}},
  "reasoning": {
    "effort": "medium"
  },
  "prompt": {
    "id": "pmpt_eq12_build_parlay_v1",
    "version": "current",
    "variables": {
      "allowed_books": "DraftKings,FanDuel,BetMGM",
      "max_legs": "8",
      "corr": "0.08",
      "min_ev": "0.08",
      "bankroll": "1000",
      "legs_json": "[{\"book\":\"Caesars\",\"game_id\":\"nfl_20251005_test\",\"market\":\"moneyline\",\"selection\":\"Team A\",\"odds\":-110,\"model_prob\":0.60,\"ev\":0.15},{\"book\":\"PointsBet\",\"game_id\":\"nfl_20251005_test2\",\"market\":\"spread\",\"selection\":\"Team B +3\",\"odds\":-105,\"model_prob\":0.58,\"ev\":0.12},{\"book\":\"DraftKings\",\"game_id\":\"nfl_20251005_chiefs_bills\",\"market\":\"spread\",\"selection\":\"Kansas City Chiefs -3.5\",\"odds\":-110,\"point\":-3.5,\"model_prob\":0.55,\"ev\":0.089,\"hook_flag\":true}]"
    }
  }
}

