[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
$ErrorActionPreference = "Stop"

# === EQ12 GPT-5 Optimized Master Launcher ===
# Implements GPT-5 best practices:
# - Structured tool preambles with clear execution plans
# - Enhanced error boundaries and escalation rules
# - Progress updates with confidence indicators
# - Reasoning traces for debugging and improvement

[CmdletBinding()]
param(
    [Parameter(Mandatory = $false)]
    [ValidateSet("minimal", "medium", "high")]
    [string]$ReasoningEffort = "medium",

    [Parameter(Mandatory = $false)]
    [ValidateSet("low", "medium", "high")]
    [string]$VerbosityLevel = "medium",

    [Parameter(Mandatory = $false)]
    [switch]$AggressiveMode,

    [Parameter(Mandatory = $false)]
    [int]$MaxToolCalls = 10
)

# GPT-5 Agentic Configuration
${script}GPT5Config = @{
    ReasoningEffort = $ReasoningEffort
    VerbosityLevel  = $VerbosityLevel
    AggressiveMode  = $AggressiveMode.IsPresent
    MaxToolCalls    = $MaxToolCalls
    StartTime       = Get-Date
    ToolCallsUsed   = 0
    ExecutionPlan   = @()
    ReasoningTraces = @()
}

# --- Safety: Unblock files with structured approach ---
function Initialize-EQ12Environment {
    [CmdletBinding()]
    param()

    Write-GPT5Preamble -Task "Initialize EQ12 Environment" -Steps @(
        "Unblock PowerShell files to prevent RemoteSigned issues",
        "Create required directory structure",
        "Initialize structured logging with rotation",
        "Validate GPT-5 configuration parameters"
    )

    try {
        $files = Get-ChildItem 'C:\EQ12' -Recurse -Include *.ps1, *.psm1, *.psd1, *.xml -ErrorAction SilentlyContinue
        $files | Unblock-File -ErrorAction SilentlyContinue
        Write-GPT5Progress -Step "Unblocked $($files.Count) PowerShell files" -Confidence 1.0
    } catch {
        Write-GPT5Error -Error "File unblock failed: $_" -Context @{Path = "C:\EQ12"; Action = "Unblock" }
    }
}

# Ensure folders with GPT-5 structured approach
$logDir = "C:\EQ12\logs"
if (-not (Test-Path $logDir)) {
    New-Item -ItemType Directory -Path $logDir -Force | Out-Null
    Write-Verbose "Created logs directory: $logDir"
}
$logPath = Join-Path $logDir "eq12_master_launcher.log"

# GPT-5 Optimized Logging Functions
function Write-GPT5Preamble {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$Task,

        [Parameter(Mandatory)]
        [string[]]$Steps
    )

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $message = "🎯 TASK: $Task"
    Write-Host $message -ForegroundColor Green
    "$timestamp | PREAMBLE | $message" | Out-File $logPath -Append

    for ($i = 0; $i -lt $Steps.Count; $i++) {
        $stepMsg = "   $($i+1). $($Steps[$i])"
        Write-Host $stepMsg -ForegroundColor Cyan
        "$timestamp | PLAN | $stepMsg" | Out-File $logPath -Append
    }

    ${script}GPT5Config.ExecutionPlan = $Steps
}

function Write-GPT5Progress {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$Step,

        [Parameter(Mandatory)]
        [ValidateRange(0.0, 1.0)]
        [double]$Confidence,

        [Parameter(Mandatory = $false)]
        [string]$Status = "EXECUTING"
    )

    ${script}GPT5Config.ToolCallsUsed++
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $confidenceIcon = if ($Confidence -ge 0.8) { "✅" } elseif ($Confidence -ge 0.6) { "⚠️" } else { "❌" }
    $message = "$confidenceIcon $Status`: $Step (Confidence: $($Confidence*100)%)"

    Write-Host $message -ForegroundColor $(if ($Confidence -ge 0.7) { "Green" } else { "Yellow" })
    "$timestamp | PROGRESS | $message" | Out-File $logPath -Append

    # Add reasoning trace
    ${script}GPT5Config.ReasoningTraces += @{
        Step       = $Step
        Confidence = $Confidence
        Timestamp  = $timestamp
        Status     = $Status
    }
}

function Write-GPT5Error {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)]
        [string]$ErrorMessage,

        [Parameter(Mandatory)]
        [hashtable]$Context
    )

    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    Write-Host "❌ ERROR: $ErrorMessage" -ForegroundColor Red
    "$timestamp | ERROR | $ErrorMessage" | Out-File $logPath -Append

    foreach ($key in $Context.Keys) {
        Write-Host "   $key`: $($Context[$key])" -ForegroundColor Red
        "$timestamp | CONTEXT | $key`: $($Context[$key])" | Out-File $logPath -Append
    }
}

# --- Simple log rotation (keep current + 4 previous = 5 total) ---
function Rotate-Log {
    if (Test-Path $logPath) {
        for ($i = 4; $i -ge 1; $i--) {
            $src = "$logPath.$i"
            $dst = "$logPath." + ($i + 1)
            if (Test-Path $src) { Move-Item -Path $src -Destination $dst -Force }
        }
        Move-Item -Path $logPath -Destination "$logPath.1" -Force
    }
}
Rotate-Log

Write-Log "EQ12 Master Launcher initialized"
Write-Host "[INIT] EQ12 Master Launcher initialized" -ForegroundColor Cyan

# --- API Key Prompt (only if missing/empty) ---
$tokenPath = "C:\EQ12\keys\tg_token.txt"
$chatIDPath = "C:\EQ12\keys\tg_chatid.txt"
if (-not (Test-Path (Split-Path $tokenPath))) { New-Item -ItemType Directory -Path (Split-Path $tokenPath) | Out-Null }

if (-not (Test-Path $tokenPath) -or -not (Get-Content $tokenPath -ErrorAction SilentlyContinue)) {
    $tgToken = Read-Host "Enter your Telegram Bot Token"
    Set-Content -Path $tokenPath -Value $tgToken
    Write-Log "Telegram token saved to keys folder"
}
if (-not (Test-Path $chatIDPath) -or -not (Get-Content $chatIDPath -ErrorAction SilentlyContinue)) {
    $tgChatID = Read-Host "Enter your Telegram Chat ID"
    Set-Content -Path $chatIDPath -Value $tgChatID
    Write-Log "Telegram chat id saved to keys folder"
}

# --- Counters for summary ---
${global}EQ12_Success = 0
${global}EQ12_Retry = 0
${global}EQ12_Fail = 0

function Retry-Command {
    param(
        [scriptblock]$ScriptBlock,
        [int]$Retries = 3,
        [int]$Delay = 5,
        [string]$ActionName = "Action"
    )
    for ($i = 1; $i -le $Retries; $i++) {
        try {
            & $ScriptBlock
            Write-Host ("[OK] {0} succeeded on attempt {1}" -f $ActionName, $i) -ForegroundColor Green
            Write-Log  ("{0} succeeded on attempt {1}" -f $ActionName, $i)
            ${global}EQ12_Success++
            return
        } catch {
            Write-Host ("[FAIL] {0} failed on attempt {1}" -f $ActionName, $i) -ForegroundColor Red
            Write-Log  ("{0} failed on attempt {1}: " -f $ActionName, $i)
            Write-Log  (($_ | Out-String).Trim())
            if ($i -lt $Retries) {
                Write-Host ("[RETRY] Retrying in {0} seconds..." -f $Delay) -ForegroundColor Yellow
                Write-Log  ("Retrying in {0} seconds..." -f $Delay)
                ${global}EQ12_Retry++
                Start-Sleep -Seconds $Delay
            } else {
                ${global}EQ12_Fail++
                Write-Host ("[FAIL] {0} failed after {1} attempts" -f $ActionName, $Retries) -ForegroundColor Red
                Write-Log  ("{0} failed after {1} attempts" -f $ActionName, $Retries)
            }
        }
    }
}

# --- Actions ---

Write-Host "[STEP] Windows Update..." -ForegroundColor Cyan
Write-Log  "Running Windows Update..."
Retry-Command { & "C:\EQ12\scripts\eq12_update.ps1" } 3 10 "Windows Update"

