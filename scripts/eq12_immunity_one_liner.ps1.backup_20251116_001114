Write-Host "EQ12 Daily Workspace Scan Complete!" -ForegroundColor Green
"@

$schedulePath = "C:\EQ12\scripts\eq12_daily_scan.ps1"
$scheduleScript | Out-File -FilePath $schedulePath -Encoding utf8

Write-Host "  ✓ Daily scan script created: $schedulePath" -ForegroundColor Green
