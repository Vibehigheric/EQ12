        Write-EQ12Log "📋 Generating final summary report..."
        $reportResult = Generate-BusinessIntelligenceReport
        if ($reportResult) {
            Write-Host "📄 Business Report: $($reportResult.markdown_report)" -ForegroundColor Cyan
        }
