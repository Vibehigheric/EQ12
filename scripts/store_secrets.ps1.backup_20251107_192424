[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
$ErrorActionPreference = "Stop"

<#
store_secrets.ps1
Interactive helper to securely store API keys for EQ12 under C:\EQ12\keys
- Prompts for OpenAI, Telegram, and ODDS keys (secure input)
- Writes each to individual files (openai.txt, telegram.txt, odds.txt)
- Restricts file permissions to the current user
- Adds `keys/` to .gitignore if not already present
#>
[CmdletBinding()]
param()

function Read-SecureSecret {
    param([string]$Prompt)
    Write-Host $Prompt -NoNewline
    $s = Read-Host -AsSecureString
    # Convert SecureString to plain text for file write (kept in memory briefly)
    $bstr = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($s)
    try {
        $plain = [Runtime.InteropServices.Marshal]::PtrToStringAuto($bstr)
    } finally {
        [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($bstr)
    }
catch {
    Write-Host "Error: $($_.Exception.Message)" -ForegroundColor Red
}
    return $plain
}

$keysDir = Join-Path $PSScriptRoot "..\keys" | Resolve-Path -Relative | ForEach-Object { Join-Path (Split-Path -Path $PSScriptRoot -Parent) 'keys' }
# Fallback if Resolve-Path didn't behave as expected
if (-not (Test-Path $keysDir)) { New-Item -Path $keysDir -ItemType Directory -Force | Out-Null }

Write-Host "Storing secrets to: $keysDir"

# helper to backup existing file
function Backup-IfExists {
    param([string]$path)
    if (Test-Path $path) {
        $bak = "$path.bak.$(Get-Date -Format yyyyMMddHHmmss)"
        Write-Host "Backing up existing file $path -> $bak"
        Copy-Item -Path $path -Destination $bak -Force
    }
}

# Ask for keys interactively
$openai = Read-SecureSecret "\nEnter OpenAI API key (or leave blank to skip): "
if ($openai) {
    $openaiPath = Join-Path $keysDir "openai.txt"
    Backup-IfExists -path $openaiPath
    Set-Content -Path $openaiPath -Value $openai -NoNewline -Encoding UTF8
    Write-Host "Saved OpenAI key to $openaiPath"
    # Restrict permissions to current user
    icacls $openaiPath /inheritance:r | Out-Null
    icacls $openaiPath /grant:r "$($env:USERNAME):(R,W)" | Out-Null
}

$telegram = Read-SecureSecret "\nEnter Telegram BOT token (or leave blank to skip): "
if ($telegram) {
    $tgPath = Join-Path $keysDir "telegram.txt"
    Backup-IfExists -path $tgPath
    Set-Content -Path $tgPath -Value $telegram -NoNewline -Encoding UTF8
    Write-Host "Saved Telegram token to $tgPath"
    icacls $tgPath /inheritance:r | Out-Null
    icacls $tgPath /grant:r "$($env:USERNAME):(R,W)" | Out-Null
}

$odds = Read-SecureSecret "\nEnter ODDS API key (or leave blank to skip): "
if ($odds) {
    $oddsPath = Join-Path $keysDir "odds.txt"
    Backup-IfExists -path $oddsPath
    Set-Content -Path $oddsPath -Value $odds -NoNewline -Encoding UTF8
    Write-Host "Saved ODDS API key to $oddsPath"
    icacls $oddsPath /inheritance:r | Out-Null
    icacls $oddsPath /grant:r "$($env:USERNAME):(R,W)" | Out-Null
}

# Ensure .gitignore contains keys/
$gitignorePath = Join-Path (Split-Path -Path $PSScriptRoot -Parent) ".gitignore"
if (-not (Test-Path $gitignorePath)) { New-Item -Path $gitignorePath -ItemType File -Force | Out-Null }
$gi = Get-Content -Path $gitignorePath -ErrorAction SilentlyContinue
if ($gi -notcontains 'keys/') {
    Add-Content -Path $gitignorePath -Value "`n# Ignore secret keys stored by local scripts`nkeys/"
    Write-Host "Appended 'keys/" to .gitignore"
} else {
    Write-Host ".gitignore already contains keys/"
}

Write-Host "Done. Remember to rotate any keys that were exposed in chat."