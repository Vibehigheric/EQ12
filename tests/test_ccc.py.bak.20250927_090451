import json
import sys
from pathlib import Path


# ensure project root
root = Path(__file__).resolve().parents[1]
if str(root) not in sys.path:
    sys.path.insert(0, str(root))

from scripts.ccc_tracker import load_watchlist, process_watchlist, save_results, CCCConfig


def test_load_watchlist() -> None:
    wl = load_watchlist('configs/amazon_watchlist.json')
    assert isinstance(wl, list)


def test_process_and_save(tmp_path) -> None:
    wl = load_watchlist('configs/amazon_watchlist.json')
    results = process_watchlist(wl)
    out = tmp_path / 'ccc.json'
    save_results(results, str(out), dry_run=False)
    assert out.exists()
    data = json.loads(out.read_text())
    assert isinstance(data, list)
