            python "$EQ12Root\chrome_governance_automation.py" --setup-profile --verbose
        }
        10 { Show-CategoryPrograms -CategoryName "Dashboard" -PythonPrograms $PythonPrograms -PowerShellPrograms $PowerShellPrograms }
        11 { Show-CategoryPrograms -CategoryName "AI" -PythonPrograms $PythonPrograms -PowerShellPrograms $PowerShellPrograms }
        12 { Show-CategoryPrograms -CategoryName "Browser" -PythonPrograms $PythonPrograms -PowerShellPrograms $PowerShellPrograms }
        13 { Show-CategoryPrograms -CategoryName "Sports" -PythonPrograms $PythonPrograms -PowerShellPrograms $PowerShellPrograms }
        14 { Show-CategoryPrograms -CategoryName "Development" -PythonPrograms $PythonPrograms -PowerShellPrograms $PowerShellPrograms }
