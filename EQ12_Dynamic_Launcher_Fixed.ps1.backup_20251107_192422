            foreach ($category in $PythonPrograms.Keys) {
                if ($PythonPrograms[$category].Count -gt 0 -or $PowerShellPrograms[$category].Count -gt 0) {
                    Write-Host "$category Programs:" -ForegroundColor Yellow
