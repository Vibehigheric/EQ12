function Show-CategoryPrograms {
    param([string]$CategoryName, [hashtable]$PythonPrograms, [hashtable]$PowerShellPrograms)

    Clear-Host
    Write-Host ""
    Write-Host "📂 $CategoryName PROGRAMS" -ForegroundColor Green
    Write-Host "=============================================================" -ForegroundColor Green
    Write-Host ""

    $counter = 1
    $programs = @()

    # Add Python programs
    foreach ($program in $PythonPrograms[$CategoryName]) {
        Write-Host "  $counter. $($program.Name) (Python)" -ForegroundColor Cyan
        Write-Host "     $($program.Description)" -ForegroundColor Gray
        $programs += $program
        $counter++
    }

    # Add PowerShell programs
    foreach ($program in $PowerShellPrograms[$CategoryName]) {
        Write-Host "  $counter. $($program.Name) (PowerShell)" -ForegroundColor Magenta
        Write-Host "     $($program.Description)" -ForegroundColor Gray
        $programs += $program
        $counter++
    }

    if ($programs.Count -eq 0) {
        Write-Host "  No programs found in this category." -ForegroundColor Yellow
    }

    Write-Host ""
    Write-Host "  0. Back to Main Menu" -ForegroundColor Red
    Write-Host ""

    do {
        $choice = Read-Host "Select a program to run (0 to go back)"

        if ($choice -eq "0") {
            return
        }

        $choiceNum = 0
        if ([int]::TryParse($choice, [ref]$choiceNum) -and $choiceNum -gt 0 -and $choiceNum -le $programs.Count) {
            $selectedProgram = $programs[$choiceNum - 1]
            Execute-Program -Program $selectedProgram
        } else {
            Write-Host "Invalid choice. Please try again." -ForegroundColor Red
        }
    } while ($true)
}

function Execute-Program {
    param([hashtable]$Program)

    Write-Host ""
    Write-Host "🚀 Executing: $($Program.Name)" -ForegroundColor Green
    Write-Host "Type: $($Program.Type)" -ForegroundColor Gray
    Write-Host "Path: $($Program.Path)" -ForegroundColor Gray
    Write-Host ""

    try {
        if ($Program.Type -eq "Python") {
            python $Program.Path
        } elseif ($Program.Type -eq "PowerShell") {
            powershell -ExecutionPolicy Bypass -File $Program.Path
        }
    } catch {
        Write-Host "Error executing program: $($_.Exception.Message)" -ForegroundColor Red
    }
}

function Execute-Choice {
    param([string]$Choice, [hashtable]$PythonPrograms, [hashtable]$PowerShellPrograms)

    switch ($Choice) {
