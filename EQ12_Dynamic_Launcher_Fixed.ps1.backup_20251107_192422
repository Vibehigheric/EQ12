[Console]::OutputEncoding = [System.Text.Encoding]::UTF8
$ErrorActionPreference = "Stop"

# EQ12 Dynamic Interactive Launcher - Auto-discovering Program Menu
# Automatically scans and categorizes all EQ12 programs for easy access

[CmdletBinding()]
param()

# Initialize global variables
$EQ12Root = "C:\EQ12"
$ScriptsPath = Join-Path $EQ12Root "scripts"

function Get-PythonPrograms {
    $pythonFiles = Get-ChildItem -Path $EQ12Root -Filter "*.py" -Recurse | Where-Object {
        $_.Name -notmatch "^test_|__pycache__|\.pyc$|conftest\.py" -and
        $_.Directory.Name -notmatch "tests|__pycache__|\.git"
    }

    $categories = @{
        "Dashboard" = @()
        "AI" = @()
        "Browser" = @()
        "Sports" = @()
        "Development" = @()
        "Security" = @()
        "Communication" = @()
        "Data" = @()
        "X_API" = @()
        "Utilities" = @()
    }

    foreach ($file in $pythonFiles) {
        $category = "Utilities"  # default
        $name = $file.Name

        if ($name -match "dashboard|server|web|flask|fastapi") { $category = "Dashboard" }
        elseif ($name -match "openai|gpt|ai|assistant|chatgpt|streaming") { $category = "AI" }
        elseif ($name -match "chrome|firefox|browser|selenium|playwright") { $category = "Browser" }
        elseif ($name -match "sports|odds|bet|cfb|nfl|parlay") { $category = "Sports" }
        elseif ($name -match "github|git|deploy|build") { $category = "Development" }
        elseif ($name -match "security|monitor|guard|audit") { $category = "Security" }
        elseif ($name -match "telegram|discord|bot|notification") { $category = "Communication" }
        elseif ($name -match "scraper|data|intelligence|analytics") { $category = "Data" }
        elseif ($name -match "twitter|x_api|social") { $category = "X_API" }

        $categories[$category] += @{
            Name = $file.BaseName
            Path = $file.FullName
            Type = "Python"
            Description = Get-ProgramDescription -Path $file.FullName
        }
    }

    return $categories
}

function Get-PowerShellPrograms {
    $psFiles = Get-ChildItem -Path $EQ12Root -Filter "*.ps1" -Recurse | Where-Object {
        $_.Name -notmatch "^test_|Tests\.ps1$" -and
        $_.Directory.Name -notmatch "tests|\.git"
    }

    $categories = @{
        "Dashboard" = @()
        "AI" = @()
        "Browser" = @()
        "Sports" = @()
        "Development" = @()
        "Security" = @()
        "Communication" = @()
        "Data" = @()
        "X_API" = @()
        "Utilities" = @()
    }

    foreach ($file in $psFiles) {
        $category = "Utilities"
        $name = $file.Name

        if ($name -match "dashboard|server|build_dashboard") { $category = "Dashboard" }
        elseif ($name -match "openai|gpt|ai|assistant|chatgpt") { $category = "AI" }
        elseif ($name -match "chrome|firefox|browser") { $category = "Browser" }
        elseif ($name -match "sports|odds|bet|cfb|nfl") { $category = "Sports" }
        elseif ($name -match "github|git|deploy|build|commit") { $category = "Development" }
        elseif ($name -match "security|monitor|guard|audit|vpn") { $category = "Security" }
        elseif ($name -match "telegram|discord|bot|notification") { $category = "Communication" }
        elseif ($name -match "scraper|backup|data") { $category = "Data" }
        elseif ($name -match "twitter|social") { $category = "X_API" }

        $categories[$category] += @{
            Name = $file.BaseName
            Path = $file.FullName
            Type = "PowerShell"
            Description = Get-ProgramDescription -Path $file.FullName
        }
    }

    return $categories
}

function Get-ProgramDescription {
    param([string]$Path)

    try {
        $content = Get-Content -Path $Path -First 10 -ErrorAction Stop
        $description = $content | Where-Object { $_ -match "^#.*" -and $_ -notmatch "^#!/" } |
                      Select-Object -First 1
        if ($description) {
            return $description.Trim("#").Trim()
        }
    } catch {}
    return "EQ12 Program"
}

