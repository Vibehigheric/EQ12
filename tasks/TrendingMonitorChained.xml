<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Date>2025-09-27T00:00:00.0000000</Date>
    <Author>EQ12-GODSTACK</Author>
    <Description>GitHub Trending Monitor + Enrichment - scrapes trending repos and generates integration suggestions</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2025-09-28T09:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT30M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <!-- Step 1: Scrape GitHub Trending and post to Telegram -->
    <Exec>
      <Command>C:\Python312\python.exe</Command>
      <Arguments>"C:\EQ12\eq12_meta_search\trending_monitor.py" --telegram</Arguments>
      <WorkingDirectory>C:\EQ12\eq12_meta_search</WorkingDirectory>
    </Exec>
    <!-- Step 2: Run General Enrichment for integration analysis -->
    <Exec>
      <Command>C:\Python312\python.exe</Command>
      <Arguments>"C:\EQ12\eq12_meta_search\enrichment.py" general --source trending_monitor --prompt "Analyze trending GitHub repos for EQ12 integration potential. Focus on: AI agents, browser automation, scraping tools, dashboard components, betting analytics, travel APIs, cannabis compliance, fleet management, credit/housing finance, dropshipping automation. Provide specific integration suggestions for each trending repo."</Arguments>
      <WorkingDirectory>C:\EQ12\eq12_meta_search</WorkingDirectory>
    </Exec>
  </Actions>
</Task>