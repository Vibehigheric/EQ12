<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Date>2025-09-27T00:00:00.0000000</Date>
    <Author>EQ12-GODSTACK</Author>
    <Description>Chained Meta Search + Enrichment - runs raw search then immediately enriches with GPT</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2025-09-28T07:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
      <Repetition>
        <Interval>PT2H</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>false</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT1H</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <!-- Step 1: Run Meta Search with raw results to Telegram -->
    <Exec>
      <Command>C:\Python312\python.exe</Command>
      <Arguments>"C:\EQ12\eq12_meta_search\meta_search.py" --query-file "C:\EQ12\eq12_meta_search\queries_news.txt" --telegram --stack general</Arguments>
      <WorkingDirectory>C:\EQ12\eq12_meta_search</WorkingDirectory>
    </Exec>
    <!-- Step 2: Run Enrichment immediately after for GPT analysis -->
    <Exec>
      <Command>C:\Python312\python.exe</Command>
      <Arguments>"C:\EQ12\eq12_meta_search\enrichment.py" general --source meta_search</Arguments>
      <WorkingDirectory>C:\EQ12\eq12_meta_search</WorkingDirectory>
    </Exec>
  </Actions>
</Task>