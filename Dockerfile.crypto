# EQ12 Coral Crypto Intelligence Stack - Docker Image
FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    wget \
    git \
    build-essential \
    pkg-config \
    libhdf5-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Coral Edge TPU runtime
RUN echo "deb https://packages.cloud.google.com/apt coral-edgetpu-stable main" | tee /etc/apt/sources.list.d/coral-edgetpu.list
RUN curl https://packages.cloud.google.com/apt/doc/apt-key.gpg | apt-key add -
RUN apt-get update && apt-get install -y \
    libedgetpu1-std \
    python3-pycoral \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.crypto.txt .
RUN pip install --no-cache-dir -r requirements.crypto.txt

# Install additional Coral TPU packages
RUN pip install --no-cache-dir \
    tflite-runtime \
    pycoral

# Copy application code
COPY scripts/ ./scripts/
COPY models/ ./models/
COPY configs/ ./configs/

# Create necessary directories
RUN mkdir -p /app/logs /app/feeds /app/reports

# Set environment variables
ENV PYTHONPATH=/app/scripts
ENV PYTHONUNBUFFERED=1

# Health check script
COPY healthcheck.py .
RUN chmod +x healthcheck.py

# Expose ports
EXPOSE 8080

# Default command
CMD ["python", "scripts/eq12_coral_crypto_master.py", "--action", "monitor"]