    # Note about Copilot
    Write-Host "  ℹ️  GitHub Copilot: Uses GitHub authentication (no API key needed)" -ForegroundColor Cyan
    Write-Host "  ℹ️  Microsoft 365 Copilot: Uses Azure AD authentication" -ForegroundColor Cyan

