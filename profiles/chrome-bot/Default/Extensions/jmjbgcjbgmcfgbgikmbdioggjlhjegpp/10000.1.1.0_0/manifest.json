         "description": "Clipping Tool",
         "suggested_key": {
            "default": "Alt+C",
            "mac": "Alt+C"
         }
      },
      "capture-page-command": {
         "description": "Full page",
         "suggested_key": {
            "default": "Alt+P",
            "mac": "Alt+F"
         }
      },
      "capture-tab-command": {
         "description": "Visible area",
         "suggested_key": {
            "default": "Alt+V",
            "mac": "Alt+V"
         }
      }
   },
   "content_scripts": [ {
