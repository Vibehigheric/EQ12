         "48": "badges/normal/Icon48.png"
      },
      "default_popup": "popup/dist/index.html",
      "default_title": "ScreenClip"
   },
   "background": {
      "service_worker": "sw/index.js",
      "type": "module"
   },
   "commands": {
      "_execute_action": {
         "suggested_key": {
            "default": "Alt+S",
            "mac": "Alt+S"
         }
