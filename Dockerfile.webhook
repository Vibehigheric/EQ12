# EQ12 Parlays Webhook container
FROM python:3.12-slim
WORKDIR /app

# Install runtime deps
RUN pip install --no-cache-dir fastapi uvicorn

# Copy only what we need (scripts and data dir)
COPY scripts/ scripts/
RUN mkdir -p data

# Expose port
EXPOSE 8000

# Default command: run uvicorn serving the webhook
CMD ["uvicorn", "scripts.eq12_parlays_webhook:app", "--host", "0.0.0.0", "--port", "8000"]
