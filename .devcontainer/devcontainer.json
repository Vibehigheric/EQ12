{
  "name": "EQ12 Advanced Development Container (VB + Python + .NET)",
  "image": "mcr.microsoft.com/dotnet/sdk:8.0",
  "userEnvProbe": "none",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/powershell:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/gpg:1": {},
    "ghcr.io/devcontainers/features/playwright:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "containerEnv": {
    "EQ12_LOGS": "/workspaces/EQ12/logs",
    "EQ12_VB_DEBUG": "true",
    "EQ12_ENVIRONMENT": "codespaces",
    "GNUPGHOME": "/home/vscode/.gnupg",
    "PIP_DISABLE_PIP_VERSION_CHECK": "1",
    "PYTHONUNBUFFERED": "1",
    "PYTHONDONTWRITEBYTECODE": "1",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "NODE_ENV": "development",
    "JUPYTER_ENABLE_LAB": "yes",
    "GITHUB_CODESPACES": "true"
  },
  "remoteEnv": {
    "PIP_DISABLE_PIP_VERSION_CHECK": "1"
  },
  "postCreateCommand": "pwsh -NoProfile -ExecutionPolicy Bypass -File .devcontainer/postCreate.ps1",
  "forwardPorts": [
    5000,
    8000,
    8888,
    9222,
    3000
  ],
  "portsAttributes": {
    "8000": {
      "label": "EQ12 Dashboard",
      "onAutoForward": "notify"
    },
    "8888": {
      "label": "Jupyter Lab",
      "onAutoForward": "openPreview"
    },
    "5000": {
      "label": "Flask/FastAPI",
      "onAutoForward": "notify"
    },
    "9222": {
      "label": "Chrome Debug",
      "onAutoForward": "silent"
    }
  },
  "mounts": [
    "source=/workspaces/EQ12/.vscode-extensions,target=/home/vscode/.vscode-server/extensions,type=bind",
    "source=${localWorkspaceFolder}/.pip-cache,target=/root/.cache/pip,type=bind"
  ],
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "settings": {
        "git.enableCommitSigning": true,
        "git.ignoreLegacyWarning": true,
        "security.allowedUNCHosts": [
          "*"
        ],
        "telemetry.enableTelemetry": false,
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": true,
        "python.linting.flake8Enabled": true,
        "python.formatting.provider": "black",
        "dotnet.completion.showCompletionItemsFromUnimportedNamespaces": true,
        "omnisharp.enableRoslynAnalyzers": true,
        "files.associations": {
          "*.vb": "vb",
          "*.vbs": "vbscript"
        }
      },
      "extensions": [
        "ms-vscode.powershell",
        "github.copilot",
        "github.copilot-chat",
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-python.flake8",
        "ms-python.black-formatter",
        "charliermarsh.ruff",
        "ms-python.isort",
        "ms-azuretools.vscode-docker",
        "ms-python.pylint",
        "ms-dotnettools.vscode-dotnet-runtime",
        "ms-dotnettools.csdevkit",
        "eamodio.gitlens",
        "ms-vscode.test-adapter-converter",
        "humao.rest-client",
        "aaron-bond.better-comments",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github"
      ]
    }
  },
  "shutdownAction": "stopContainer",
  "workspaceFolder": "/workspaces/EQ12"
}