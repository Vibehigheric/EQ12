{
  "compilerOptions": {
    "moduleResolution": "node",
    "target": "ES2020",
    "module": "commonjs",
    "baseUrl": "./",
    "paths": {
      "*": ["node_modules/*", "scripts/*"]
    },
    "checkJs": false,
    "resolveJsonModule": true
  },
  "exclude": [
    "profiles",
    "Extensions",
    "envs",
    ".venv",
    ".venv_new",
    "node_modules",
    "data",
    "logs",
    "__pycache__",
    ".git",
    ".pytest_cache",
    ".mypy_cache"
  ],
  "include": [
    "scripts/**/*.js",
    "dashboard/**/*.js"
  ]
}
