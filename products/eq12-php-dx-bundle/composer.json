{
    "name": "eq12/php-dx-bundle",
    "description": "Professional Sports Betting Development Kit with Advanced Intelephense Configuration",
    "version": "1.0.0",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "EQ12 Team",
            "email": "dev@eq12.com",
            "homepage": "https://eq12.dev"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpstan/phpstan": "^1.8",
        "squizlabs/php_codesniffer": "^3.7",
        "friendsofphp/php-cs-fixer": "^3.13",
        "psalm/plugin-phpunit": "^0.18",
        "vimeo/psalm": "^4.30"
    },
    "autoload": {
        "psr-4": {
            "EQ12\\": "src/",
            "EQ12\\Types\\": "types/",
            "EQ12\\Helpers\\": "helpers/"
        },
        "files": [
            "helpers/intelephense_sports_helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "EQ12\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.php",
        "cs:check": "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
        "phpstan": "phpstan analyse src tests --level=8",
        "psalm": "psalm --show-info=true",
        "quality": [
            "@cs:check",
            "@phpstan", 
            "@psalm",
            "@test"
        ],
        "setup": [
            "composer install",
            "@cs:fix",
            "echo 'EQ12 PHP DX Bundle installed successfully!'"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "eq12": {
            "version": "1.0.0",
            "type": "dx-bundle",
            "features": [
                "intelephense-pro-config",
                "sports-betting-types",
                "odds-api-integration",
                "kelly-criterion-helpers",
                "sgp-builder-types"
            ]
        }
    }
}