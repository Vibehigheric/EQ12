{
    "name": "eq12-live-server",
    "displayName": "EQ12 Live Server",
    "description": "Live server with hot reload for EQ12 governance and automation dashboards",
    "version": "1.0.0",
    "publisher": "EQ12",
    "author": {
        "name": "EQ12 Team",
        "email": "team@eq12.dev"
    },
    "license": "MIT",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Other",
        "Debuggers",
        "Extension Packs"
    ],
    "keywords": [
        "live server",
        "hot reload",
        "dashboard",
        "governance",
        "automation",
        "eq12"
    ],
    "activationEvents": [
        "onStartupFinished",
        "workspaceContains:**/*.html",
        "workspaceContains:**/dashboard/**",
        "workspaceContains:**/eq12_*"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "eq12.liveServer.start",
                "title": "Start EQ12 Live Server",
                "category": "EQ12"
            },
            {
                "command": "eq12.liveServer.stop",
                "title": "Stop EQ12 Live Server",
                "category": "EQ12"
            },
            {
                "command": "eq12.liveServer.restart",
                "title": "Restart EQ12 Live Server",
                "category": "EQ12"
            },
            {
                "command": "eq12.liveServer.openDashboard",
                "title": "Open EQ12 Dashboard",
                "category": "EQ12"
            },
            {
                "command": "eq12.liveServer.healthCheck",
                "title": "Run EQ12 Health Check",
                "category": "EQ12"
            },
            {
                "command": "eq12.liveServer.changeWorkspace",
                "title": "Change EQ12 Workspace",
                "category": "EQ12"
            }
        ],
        "configuration": {
            "title": "EQ12 Live Server",
            "properties": {
                "eq12.liveServer.port": {
                    "type": "number",
                    "default": 5500,
                    "minimum": 0,
                    "maximum": 65535,
                    "description": "Set Custom Port Number of EQ12 Live Server. Set 0 if you want random port."
                },
                "eq12.liveServer.root": {
                    "type": "string",
                    "default": "/dashboard",
                    "description": "Set Custom root of EQ12 Live Server.",
                    "pattern": "^/.*"
                },
                "eq12.liveServer.host": {
                    "type": "string",
                    "default": "127.0.0.1",
                    "description": "To switch between localhost and 127.0.0.1 or IP"
                },
                "eq12.liveServer.useLocalIp": {
                    "type": "boolean",
                    "default": false,
                    "description": "Use local IP as host instead of localhost"
                },
                "eq12.liveServer.NoBrowser": {
                    "type": "boolean",
                    "default": false,
                    "description": "If it is true, EQ12 Live Server will start without opening browser"
                },
                "eq12.liveServer.CustomBrowser": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "default": null,
                    "enum": [
                        null,
                        "chrome",
                        "firefox",
                        "edge",
                        "safari"
                    ],
                    "description": "To set custom browser for EQ12 Live Server"
                },
                "eq12.liveServer.ChromeDebuggingAttachment": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable Chrome Debugging Attachment to EQ12 Live Server"
                },
                "eq12.liveServer.ignoreFiles": {
                    "type": "array",
                    "default": [
                        ".vscode/**",
                        "**/*.scss",
                        "**/*.sass",
                        "**/*.ts",
                        "**/*.py[co]",
                        "**/__pycache__/**",
                        "**/node_modules/**",
                        "**/.git/**"
                    ],
                    "description": "To ignore specific file changes for live reload"
                },
                "eq12.liveServer.donotShowInfoMsg": {
                    "type": "boolean",
                    "default": false,
                    "description": "To turn off information pop-up messages"
                },
                "eq12.liveServer.donotVerifyTags": {
                    "type": "boolean",
                    "default": false,
                    "description": "To turn off prompt warning message if body or head tag is missing"
                },
                "eq12.liveServer.https": {
                    "type": "object",
                    "default": {
                        "enable": false,
                        "cert": "",
                        "key": "",
                        "passphrase": ""
                    },
                    "properties": {
                        "enable": {
                            "type": "boolean",
                            "description": "Enable HTTPS"
                        },
                        "cert": {
                            "type": "string",
                            "description": "Path to certificate file"
                        },
                        "key": {
                            "type": "string",
                            "description": "Path to private key file"
                        },
                        "passphrase": {
                            "type": "string",
                            "description": "Passphrase for the key"
                        }
                    },
                    "description": "HTTPS configuration for EQ12 Live Server"
                },
                "eq12.liveServer.proxy": {
                    "type": "object",
                    "default": {
                        "enable": false,
                        "baseUri": "",
                        "proxyUri": ""
                    },
                    "properties": {
                        "enable": {
                            "type": "boolean",
                            "description": "Enable proxy"
                        },
                        "baseUri": {
                            "type": "string",
                            "description": "Base URI for proxy"
                        },
                        "proxyUri": {
                            "type": "string",
                            "description": "Proxy URI"
                        }
                    },
                    "description": "Proxy configuration for EQ12 Live Server"
                },
                "eq12.liveServer.mount": {
                    "type": "array",
                    "default": [],
                    "description": "Mount directories to specific routes [[route, path]]"
                },
                "eq12.liveServer.file": {
                    "type": "string",
                    "default": "",
                    "description": "Default file to serve for SPA routing"
                },
                "eq12.liveServer.wait": {
                    "type": "number",
                    "default": 100,
                    "description": "Delay in milliseconds before reloading"
                },
                "eq12.liveServer.fullReload": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable full page reload instead of injected reload"
                },
                "eq12.liveServer.showOnStatusbar": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show EQ12 Live Server status on status bar"
                }
            }
        },
        "keybindings": [
            {
                "command": "eq12.liveServer.start",
                "key": "alt+e alt+l",
                "mac": "cmd+e cmd+l"
            },
            {
                "command": "eq12.liveServer.stop",
                "key": "alt+e alt+s",
                "mac": "cmd+e cmd+s"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "when": "resourceExtname == .html",
                    "command": "eq12.liveServer.start",
                    "group": "eq12@1"
                }
            ],
            "editor/context": [
                {
                    "when": "resourceExtname == .html",
                    "command": "eq12.liveServer.start",
                    "group": "eq12@1"
                },
                {
                    "when": "eq12.liveServer.isRunning",
                    "command": "eq12.liveServer.stop",
                    "group": "eq12@2"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js",
        "test:e2e": "wdio test/wdio.conf.ts"
    },
    "devDependencies": {
        "@types/mocha": "^9.1.1",
        "@types/node": "26.x",
        "@types/vscode": "^1.125.0",
        "@typescript-eslint/eslint-plugin": "^5.31.0",
        "@typescript-eslint/parser": "^5.31.0",
        "@vscode/test-electron": "^2.1.5",
        "@wdio/cli": "^9.20.0",
        "@wdio/local-runner": "^9.20.0",
        "@wdio/mocha-framework": "^7.0.0",
        "eslint": "^10.5.0",
        "glob": "^8.0.3",
        "mocha": "^10.0.0",
        "typescript": "^4.7.4",
        "wdio-vscode-service": "^6.1.4"
    },
    "dependencies": {
        "chokidar": "^3.5.3",
        "colors": "^1.4.0",
        "connect": "^3.7.0",
        "faye-websocket": "^0.11.4",
        "http-proxy": "^1.18.1",
        "open": "^8.4.0",
        "puppeteer": "24.24.0",
        "send": "^1.2.1",
        "serve-index": "^1.9.1",
        "web-ext": "^8.2.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/eq12/vscode-eq12-live-server.git"
    },
    "bugs": {
        "url": "https://github.com/eq12/vscode-eq12-live-server/issues"
    },
    "homepage": "https://github.com/eq12/vscode-eq12-live-server#readme",
    "icon": "assets/eq12-icon.png",
    "galleryBanner": {
        "color": "#1e1e1e",
        "theme": "dark"
    }
}
