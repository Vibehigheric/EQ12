{
    "manifest_version": 3,
    "name": "EQ12 Betting Dashboard Companion",
    "version": "1.0.0",
    "description": "Advanced betting dashboard with parlay generation, privacy protection, developer tools, and VPN management.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "EQ12 Betting Dashboard",
        "default_popup": "popup_v3_enhanced.html"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "background": {
        "service_worker": "background_v3_enhanced.js",
        "type": "module"
    },
    "permissions": [
        "storage",
        "notifications",
        "activeTab",
        "scripting",
        "tabs",
        "alarms",
        "declarativeNetRequest",
        "proxy",
        "cookies",
        "browsingData",
        "webRequest",
        "privacy",
        "contextMenus"
    ],
    "host_permissions": [
        "*://*.draftkings.com/*",
        "*://*.fanduel.com/*",
        "*://*.betmgm.com/*",
        "*://*.bet365.com/*",
        "*://*.caesars.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.ngrok.io/*",
        "https://api.telegram.org/*",
        "https://api.ipify.org/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "*://*.draftkings.com/*",
                "*://*.fanduel.com/*",
                "*://*.betmgm.com/*",
                "*://*.bet365.com/*",
                "*://*.caesars.com/*"
            ],
            "js": [
                "sportsbook_scraper_v3_enhanced.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "privacy_manager.js",
                "developer_tools.js",
                "ui_enhancer.js",
                "proxy_manager.js",
                "tab_manager.js",
                "testing_dashboard.html",
                "styles.css"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "privacy_rules",
                "enabled": true,
                "path": "privacy_rules.json"
            }
        ]
    }
}
