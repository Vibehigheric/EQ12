    {
      "id": 6,
      "type": "bargauge",
      "title": "Governance Health Score",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "100 - (eq12_godstack_failing_checks + eq12_godstack_alerts) * 10",
          "legendFormat": "Health Score",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Governance Summary",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          },
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "expr": "eq12_godstack_open_prs",
          "format": "table",
          "instant": true,
          "legendFormat": "Open PRs",
          "refId": "A"
        },
        {
          "expr": "eq12_godstack_failing_checks",
          "format": "table", 
          "instant": true,
          "legendFormat": "Failing Checks",
          "refId": "B"
        },
        {
          "expr": "eq12_godstack_sensitive_prs",
          "format": "table",
          "instant": true,
          "legendFormat": "Sensitive PRs",
          "refId": "C"
        },
        {
          "expr": "eq12_godstack_alerts",
          "format": "table",
          "instant": true,
          "legendFormat": "Active Alerts",
          "refId": "D"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "Value #A": "Open PRs",
              "Value #B": "Failing Checks", 
              "Value #C": "Sensitive PRs",
              "Value #D": "Active Alerts"
            }
          }
        }
      ]
    }
