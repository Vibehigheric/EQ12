{
  "id": null,
  "uid": "eq12-governance-prometheus",
  "title": "EQ12 GODSTACK Governance (Prometheus)",
  "description": "Real-time governance monitoring dashboard using Prometheus metrics from alert_manager.py",
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
